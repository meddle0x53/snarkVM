import arcn_access_manager_v1.aleo;
import credits.aleo;
import multi_token_support_program.aleo;

program arcn_pool_v2_1_1.aleo;

struct TokenMetadata:
    token_id as field;
    name as u128;
    symbol as u128;
    decimals as u8;
    supply as u128;
    max_supply as u128;
    admin as address;
    external_authorization_required as boolean;
    external_authorization_party as address;

struct TokenOwner:
    account as address;
    token_id as field;

record PoolAdmin:
    owner as address.private;
    pool_key as field.private;

struct PoolInfo:
    id as field;
    token1_id as field;
    token2_id as field;
    reserve1 as u128;
    reserve2 as u128;
    lp_total_supply as u128;
    swap_fee as u16;
    ampl_coef as u16;
    pool_type as u8;

struct PoolDescriptor:
    token1_id as field;
    token2_id as field;
    swap_fee as u16;
    ampl_coef as u16;
    pool_type as u8;

record LpTokenReceipt:
    owner as address.private;
    token1_id as field.private;
    token2_id as field.private;
    pool_id as field.private;
    deposit_salt as field.private;

struct ExtraAmount:
    token_id as field;
    token_amount as u128;

struct DepositValue:
    amount as u128;
    pool_id as field;

struct CollectedFee:
    protocol_in_fee as u128;
    protocol_out_fee as u128;

struct DepositOwner:
    from as address;
    salt as field;

struct ProtocolFeeConfig:
    rate as u16;
    foundation as address;

record ExtraAmountVoucher:
    owner as address.private;
    token_id as field.private;
    voucher as field.private;

mapping amm_pools:
    key as field.public;
    value as PoolInfo.public;

mapping amm_deposits:
    key as field.public;
    value as DepositValue.public;

mapping amm_extras:
    key as field.public;
    value as ExtraAmount.public;

mapping protocol_fee:
    key as field.public;
    value as ProtocolFeeConfig.public;

mapping accrued_protocol_fees:
    key as field.public;
    value as u128.public;

mapping whitelisted_fee_tiers:
    key as u16.public;
    value as boolean.public;

function initialize:
    async initialize into r0;
    output r0 as arcn_pool_v2_1_1.aleo/initialize.future;

finalize initialize:
    contains whitelisted_fee_tiers[1u16] into r0;
    not r0 into r1;
    assert.eq r1 true;
    contains whitelisted_fee_tiers[5u16] into r2;
    not r2 into r3;
    assert.eq r3 true;
    contains whitelisted_fee_tiers[30u16] into r4;
    not r4 into r5;
    assert.eq r5 true;
    set true into whitelisted_fee_tiers[1u16];
    set true into whitelisted_fee_tiers[5u16];
    set true into whitelisted_fee_tiers[30u16];

function set_protocol_fee_public:
    input r0 as field.public;
    input r1 as ProtocolFeeConfig.public;
    lte r1.rate 10000u16 into r2;
    assert.eq r2 true;
    call arcn_access_manager_v1.aleo/check_access_public self.caller into r3;
    async set_protocol_fee_public r3 r0 r1 into r4;
    output r4 as arcn_pool_v2_1_1.aleo/set_protocol_fee_public.future;

finalize set_protocol_fee_public:
    input r0 as arcn_access_manager_v1.aleo/check_access_public.future;
    input r1 as field.public;
    input r2 as ProtocolFeeConfig.public;
    await r0;
    is.eq r1 1field into r3;
    contains amm_pools[r1] into r4;
    or r3 r4 into r5;
    assert.eq r5 true;
    set r2 into protocol_fee[r1];

function set_fee_whitelist_public:
    input r0 as u16.public;
    input r1 as boolean.public;
    call arcn_access_manager_v1.aleo/check_access_public self.caller into r2;
    async set_fee_whitelist_public r2 r0 r1 into r3;
    output r3 as arcn_pool_v2_1_1.aleo/set_fee_whitelist_public.future;

finalize set_fee_whitelist_public:
    input r0 as arcn_access_manager_v1.aleo/check_access_public.future;
    input r1 as u16.public;
    input r2 as boolean.public;
    await r0;
    set r2 into whitelisted_fee_tiers[r1];

function create_pool:
    input r0 as address.public;
    input r1 as multi_token_support_program.aleo/Token.record;
    input r2 as u128.public;
    input r3 as multi_token_support_program.aleo/Token.record;
    input r4 as u128.public;
    input r5 as u16.public;
    input r6 as field.private;
    input r7 as u8.public;
    input r8 as u16.public;
    is.eq r7 0u8 into r9;
    is.eq r7 1u8 into r10;
    or r9 r10 into r11;
    assert.eq r11 true;
    is.eq r7 1u8 into r12;
    gt r8 0u16 into r13;
    is.eq r8 0u16 into r14;
    ternary r12 r13 r14 into r15;
    assert.eq r15 true;
    gt r2 0u128 into r16;
    gt r4 0u128 into r17;
    and r16 r17 into r18;
    assert.eq r18 true;
    lte r5 10000u16 into r19;
    assert.eq r19 true;
    gte r1.amount r2 into r20;
    gte r3.amount r4 into r21;
    and r20 r21 into r22;
    assert.eq r22 true;
    lt r1.token_id r3.token_id into r23;
    assert.eq r23 true;
    cast r0 r6 into r24 as DepositOwner;
    hash.bhp256 r24 into r25 as field;
    mul r2 r4 into r26;
    gt r8 0u16 into r27;
    ternary r27 r8 1u16 into r28;
    add r2 r4 into r29;
    is.eq r29 0u128 into r30;
    cast r28 into r31 as u128;
    is.eq r31 0u128 into r32;
    ternary r32 1u128 r31 into r33;
    mul r33 2u128 into r34;
    mul r29 r29 into r35;
    is.eq r2 0u128 into r36;
    ternary r36 1u128 r2 into r37;
    mul r37 2u128 into r38;
    div r35 r38 into r39;
    mul r39 r29 into r40;
    is.eq r4 0u128 into r41;
    ternary r41 1u128 r4 into r42;
    mul r42 2u128 into r43;
    div r40 r43 into r44;
    mul r34 r29 into r45;
    mul r44 2u128 into r46;
    add r45 r46 into r47;
    mul r47 r29 into r48;
    sub r34 1u128 into r49;
    is.eq r29 0u128 into r50;
    ternary r50 1u128 r29 into r51;
    mul r49 r51 into r52;
    is.eq r44 0u128 into r53;
    ternary r53 1u128 r44 into r54;
    mul 3u128 r54 into r55;
    add r52 r55 into r56;
    div r48 r56 into r57;
    gt r57 r29 into r58;
    ternary r58 r57 r29 into r59;
    lt r57 r29 into r60;
    ternary r60 r57 r29 into r61;
    sub r59 r61 into r62;
    lte r62 1u128 into r63;
    ternary r63 true false into r64;
    mul r57 r57 into r65;
    is.eq r2 0u128 into r66;
    ternary r66 1u128 r2 into r67;
    mul r67 2u128 into r68;
    div r65 r68 into r69;
    mul r69 r57 into r70;
    is.eq r4 0u128 into r71;
    ternary r71 1u128 r4 into r72;
    mul r72 2u128 into r73;
    div r70 r73 into r74;
    mul r34 r29 into r75;
    mul r74 2u128 into r76;
    add r75 r76 into r77;
    mul r77 r57 into r78;
    sub r34 1u128 into r79;
    is.eq r57 0u128 into r80;
    ternary r80 1u128 r57 into r81;
    mul r79 r81 into r82;
    is.eq r74 0u128 into r83;
    ternary r83 1u128 r74 into r84;
    mul 3u128 r84 into r85;
    add r82 r85 into r86;
    div r78 r86 into r87;
    gt r87 r57 into r88;
    ternary r88 r87 r57 into r89;
    lt r87 r57 into r90;
    ternary r90 r87 r57 into r91;
    sub r89 r91 into r92;
    lte r92 1u128 into r93;
    ternary r93 true false into r94;
    mul r87 r87 into r95;
    is.eq r2 0u128 into r96;
    ternary r96 1u128 r2 into r97;
    mul r97 2u128 into r98;
    div r95 r98 into r99;
    mul r99 r87 into r100;
    is.eq r4 0u128 into r101;
    ternary r101 1u128 r4 into r102;
    mul r102 2u128 into r103;
    div r100 r103 into r104;
    mul r34 r29 into r105;
    mul r104 2u128 into r106;
    add r105 r106 into r107;
    mul r107 r87 into r108;
    sub r34 1u128 into r109;
    is.eq r87 0u128 into r110;
    ternary r110 1u128 r87 into r111;
    mul r109 r111 into r112;
    is.eq r104 0u128 into r113;
    ternary r113 1u128 r104 into r114;
    mul 3u128 r114 into r115;
    add r112 r115 into r116;
    div r108 r116 into r117;
    gt r117 r87 into r118;
    ternary r118 r117 r87 into r119;
    lt r117 r87 into r120;
    ternary r120 r117 r87 into r121;
    sub r119 r121 into r122;
    lte r122 1u128 into r123;
    ternary r123 true false into r124;
    mul r117 r117 into r125;
    is.eq r2 0u128 into r126;
    ternary r126 1u128 r2 into r127;
    mul r127 2u128 into r128;
    div r125 r128 into r129;
    mul r129 r117 into r130;
    is.eq r4 0u128 into r131;
    ternary r131 1u128 r4 into r132;
    mul r132 2u128 into r133;
    div r130 r133 into r134;
    mul r34 r29 into r135;
    mul r134 2u128 into r136;
    add r135 r136 into r137;
    mul r137 r117 into r138;
    sub r34 1u128 into r139;
    is.eq r117 0u128 into r140;
    ternary r140 1u128 r117 into r141;
    mul r139 r141 into r142;
    is.eq r134 0u128 into r143;
    ternary r143 1u128 r134 into r144;
    mul 3u128 r144 into r145;
    add r142 r145 into r146;
    div r138 r146 into r147;
    gt r147 r117 into r148;
    ternary r148 r147 r117 into r149;
    lt r147 r117 into r150;
    ternary r150 r147 r117 into r151;
    sub r149 r151 into r152;
    lte r152 1u128 into r153;
    ternary r153 true false into r154;
    mul r147 r147 into r155;
    is.eq r2 0u128 into r156;
    ternary r156 1u128 r2 into r157;
    mul r157 2u128 into r158;
    div r155 r158 into r159;
    mul r159 r147 into r160;
    is.eq r4 0u128 into r161;
    ternary r161 1u128 r4 into r162;
    mul r162 2u128 into r163;
    div r160 r163 into r164;
    mul r34 r29 into r165;
    mul r164 2u128 into r166;
    add r165 r166 into r167;
    mul r167 r147 into r168;
    sub r34 1u128 into r169;
    is.eq r147 0u128 into r170;
    ternary r170 1u128 r147 into r171;
    mul r169 r171 into r172;
    is.eq r164 0u128 into r173;
    ternary r173 1u128 r164 into r174;
    mul 3u128 r174 into r175;
    add r172 r175 into r176;
    div r168 r176 into r177;
    gt r177 r147 into r178;
    ternary r178 r177 r147 into r179;
    lt r177 r147 into r180;
    ternary r180 r177 r147 into r181;
    sub r179 r181 into r182;
    lte r182 1u128 into r183;
    ternary r183 true false into r184;
    mul r177 r177 into r185;
    is.eq r2 0u128 into r186;
    ternary r186 1u128 r2 into r187;
    mul r187 2u128 into r188;
    div r185 r188 into r189;
    mul r189 r177 into r190;
    is.eq r4 0u128 into r191;
    ternary r191 1u128 r4 into r192;
    mul r192 2u128 into r193;
    div r190 r193 into r194;
    mul r34 r29 into r195;
    mul r194 2u128 into r196;
    add r195 r196 into r197;
    mul r197 r177 into r198;
    sub r34 1u128 into r199;
    is.eq r177 0u128 into r200;
    ternary r200 1u128 r177 into r201;
    mul r199 r201 into r202;
    is.eq r194 0u128 into r203;
    ternary r203 1u128 r194 into r204;
    mul 3u128 r204 into r205;
    add r202 r205 into r206;
    div r198 r206 into r207;
    gt r207 r177 into r208;
    ternary r208 r207 r177 into r209;
    lt r207 r177 into r210;
    ternary r210 r207 r177 into r211;
    sub r209 r211 into r212;
    lte r212 1u128 into r213;
    ternary r213 true false into r214;
    mul r207 r207 into r215;
    is.eq r2 0u128 into r216;
    ternary r216 1u128 r2 into r217;
    mul r217 2u128 into r218;
    div r215 r218 into r219;
    mul r219 r207 into r220;
    is.eq r4 0u128 into r221;
    ternary r221 1u128 r4 into r222;
    mul r222 2u128 into r223;
    div r220 r223 into r224;
    mul r34 r29 into r225;
    mul r224 2u128 into r226;
    add r225 r226 into r227;
    mul r227 r207 into r228;
    sub r34 1u128 into r229;
    is.eq r207 0u128 into r230;
    ternary r230 1u128 r207 into r231;
    mul r229 r231 into r232;
    is.eq r224 0u128 into r233;
    ternary r233 1u128 r224 into r234;
    mul 3u128 r234 into r235;
    add r232 r235 into r236;
    div r228 r236 into r237;
    gt r237 r207 into r238;
    ternary r238 r237 r207 into r239;
    lt r237 r207 into r240;
    ternary r240 r237 r207 into r241;
    sub r239 r241 into r242;
    lte r242 1u128 into r243;
    ternary r243 true false into r244;
    mul r237 r237 into r245;
    is.eq r2 0u128 into r246;
    ternary r246 1u128 r2 into r247;
    mul r247 2u128 into r248;
    div r245 r248 into r249;
    mul r249 r237 into r250;
    is.eq r4 0u128 into r251;
    ternary r251 1u128 r4 into r252;
    mul r252 2u128 into r253;
    div r250 r253 into r254;
    mul r34 r29 into r255;
    mul r254 2u128 into r256;
    add r255 r256 into r257;
    mul r257 r237 into r258;
    sub r34 1u128 into r259;
    is.eq r237 0u128 into r260;
    ternary r260 1u128 r237 into r261;
    mul r259 r261 into r262;
    is.eq r254 0u128 into r263;
    ternary r263 1u128 r254 into r264;
    mul 3u128 r264 into r265;
    add r262 r265 into r266;
    div r258 r266 into r267;
    gt r267 r237 into r268;
    ternary r268 r267 r237 into r269;
    lt r267 r237 into r270;
    ternary r270 r267 r237 into r271;
    sub r269 r271 into r272;
    lte r272 1u128 into r273;
    ternary r273 true false into r274;
    ternary r274 r267 r267 into r275;
    ternary r244 r237 r275 into r276;
    ternary r214 r207 r276 into r277;
    ternary r184 r177 r277 into r278;
    ternary r154 r147 r278 into r279;
    ternary r124 r117 r279 into r280;
    ternary r94 r87 r280 into r281;
    ternary r64 r57 r281 into r282;
    ternary r30 0u128 r282 into r283;
    cast r1.token_id r3.token_id r5 r8 r7 into r284 as PoolDescriptor;
    hash.bhp256 r284 into r285 as field;
    call multi_token_support_program.aleo/transfer_private_to_public arcn_pool_v2_1_1.aleo r2 r1 into r286 r287;
    call multi_token_support_program.aleo/transfer_private_to_public arcn_pool_v2_1_1.aleo r4 r3 into r288 r289;
    cast r0 r285 into r290 as PoolAdmin.record;
    cast r0 r1.token_id r3.token_id r285 r6 into r291 as LpTokenReceipt.record;
    is.eq r7 0u8 into r292;
    is.eq r7 1u8 into r293;
    ternary r293 r283 0u128 into r294;
    ternary r292 r26 r294 into r295;
    gte r295 100000000u128 into r296;
    assert.eq r296 true;
    async create_pool r287 r289 r285 r1.token_id r2 r3.token_id r4 r5 r25 r7 r295 r8 into r297;
    output r290 as PoolAdmin.record;
    output r286 as multi_token_support_program.aleo/Token.record;
    output r288 as multi_token_support_program.aleo/Token.record;
    output r291 as LpTokenReceipt.record;
    output r297 as arcn_pool_v2_1_1.aleo/create_pool.future;

finalize create_pool:
    input r0 as multi_token_support_program.aleo/transfer_private_to_public.future;
    input r1 as multi_token_support_program.aleo/transfer_private_to_public.future;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u128.public;
    input r5 as field.public;
    input r6 as u128.public;
    input r7 as u16.public;
    input r8 as field.public;
    input r9 as u8.public;
    input r10 as u128.public;
    input r11 as u16.public;
    cast r7 into r12 as u16;
    get.or_use whitelisted_fee_tiers[r12] false into r13;
    assert.eq r13 true;
    contains amm_pools[r2] into r14;
    not r14 into r15;
    assert.eq r15 true;
    gt r10 0u128 into r16;
    assert.eq r16 true;
    await r0;
    await r1;
    cast r2 r3 r5 r4 r6 r10 r7 r11 r9 into r17 as PoolInfo;
    set r17 into amm_pools[r2];
    contains amm_deposits[r8] into r18;
    not r18 into r19;
    assert.eq r19 true;
    div r10 100000000u128 into r20;
    sub r10 r20 into r21;
    cast r21 r2 into r22 as DepositValue;
    set r22 into amm_deposits[r8];

function transfer_pool_ownership:
    input r0 as PoolAdmin.record;
    input r1 as address.private;
    cast r1 r0.pool_key into r2 as PoolAdmin.record;
    output r2 as PoolAdmin.record;

function transfer_voucher:
    input r0 as ExtraAmountVoucher.record;
    input r1 as address.private;
    cast r1 r0.token_id r0.voucher into r2 as ExtraAmountVoucher.record;
    output r2 as ExtraAmountVoucher.record;

function transfer_lp_receipt:
    input r0 as LpTokenReceipt.record;
    input r1 as address.private;
    cast r1 r0.token1_id r0.token2_id r0.pool_id r0.deposit_salt into r2 as LpTokenReceipt.record;
    cast r0.owner r0.deposit_salt into r3 as DepositOwner;
    hash.bhp256 r3 into r4 as field;
    cast r1 r0.deposit_salt into r5 as DepositOwner;
    hash.bhp256 r5 into r6 as field;
    async transfer_lp_receipt r4 r6 into r7;
    output r2 as LpTokenReceipt.record;
    output r7 as arcn_pool_v2_1_1.aleo/transfer_lp_receipt.future;

finalize transfer_lp_receipt:
    input r0 as field.public;
    input r1 as field.public;
    is.neq r0 r1 into r2;
    branch.eq r2 false to end_then_0_0;
    contains amm_deposits[r1] into r3;
    not r3 into r4;
    assert.eq r4 true;
    get amm_deposits[r0] into r5;
    remove amm_deposits[r0];
    set r5 into amm_deposits[r1];
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    position end_otherwise_0_1;

function add_amm_liquidity:
    input r0 as field.public;
    input r1 as address.private;
    input r2 as multi_token_support_program.aleo/Token.record;
    input r3 as u128.public;
    input r4 as multi_token_support_program.aleo/Token.record;
    input r5 as u128.public;
    input r6 as field.private;
    input r7 as field.public;
    input r8 as field.public;
    lt r2.token_id r4.token_id into r9;
    assert.eq r9 true;
    cast r1 r6 into r10 as DepositOwner;
    hash.bhp256 r10 into r11 as field;
    call multi_token_support_program.aleo/transfer_private_to_public arcn_pool_v2_1_1.aleo r3 r2 into r12 r13;
    call multi_token_support_program.aleo/transfer_private_to_public arcn_pool_v2_1_1.aleo r5 r4 into r14 r15;
    cast r1 r2.token_id r4.token_id r0 r6 into r16 as LpTokenReceipt.record;
    cast self.signer r2.token_id r7 into r17 as ExtraAmountVoucher.record;
    cast self.signer r4.token_id r8 into r18 as ExtraAmountVoucher.record;
    async add_amm_liquidity r13 r15 r0 r11 r2.token_id r3 r4.token_id r5 r7 r8 into r19;
    output r12 as multi_token_support_program.aleo/Token.record;
    output r14 as multi_token_support_program.aleo/Token.record;
    output r16 as LpTokenReceipt.record;
    output r17 as ExtraAmountVoucher.record;
    output r18 as ExtraAmountVoucher.record;
    output r19 as arcn_pool_v2_1_1.aleo/add_amm_liquidity.future;

finalize add_amm_liquidity:
    input r0 as multi_token_support_program.aleo/transfer_private_to_public.future;
    input r1 as multi_token_support_program.aleo/transfer_private_to_public.future;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as field.public;
    input r5 as u128.public;
    input r6 as field.public;
    input r7 as u128.public;
    input r8 as field.public;
    input r9 as field.public;
    contains amm_deposits[r3] into r10;
    not r10 into r11;
    assert.eq r11 true;
    get amm_pools[r2] into r12;
    assert.neq r4 r6;
    is.eq r12.token1_id r4 into r13;
    is.eq r12.token2_id r4 into r14;
    or r13 r14 into r15;
    assert.eq r15 true;
    is.eq r12.token1_id r6 into r16;
    is.eq r12.token2_id r6 into r17;
    or r16 r17 into r18;
    assert.eq r18 true;
    await r0;
    await r1;
    is.eq r12.pool_type 0u8 into r19;
    branch.eq r19 false to end_then_0_2;
    mul r5 r12.lp_total_supply into r20;
    div r20 r12.reserve1 into r21;
    mul r7 r12.lp_total_supply into r22;
    div r22 r12.reserve2 into r23;
    lt r21 r23 into r24;
    ternary r24 r21 r23 into r25;
    gt r25 0u128 into r26;
    assert.eq r26 true;
    mul r25 r12.reserve1 into r27;
    div r27 r12.lp_total_supply into r28;
    mul r25 r12.reserve2 into r29;
    div r29 r12.lp_total_supply into r30;
    sub r5 r28 into r31;
    sub r7 r30 into r32;
    add r12.reserve1 r28 into r33;
    add r12.reserve2 r30 into r34;
    add r12.lp_total_supply r25 into r35;
    cast r12.id r12.token1_id r12.token2_id r33 r34 r35 r12.swap_fee r12.ampl_coef r12.pool_type into r36 as PoolInfo;
    cast r12.token1_id r31 into r37 as ExtraAmount;
    cast r12.token2_id r32 into r38 as ExtraAmount;
    set r36 into amm_pools[r2];
    cast r25 r2 into r39 as DepositValue;
    set r39 into amm_deposits[r3];
