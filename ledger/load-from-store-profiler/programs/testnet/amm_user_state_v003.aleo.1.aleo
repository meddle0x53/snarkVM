    cast r1 0u8 0u128 0u128 0u128 0u128 0u128 0u128 0u128 false false into r18 as ReserveConfig;
    get.or_use amm_reserve_state_v003.aleo/reserve_config[r1] r18 into r19;
    assert.eq r19.is_active true;
    assert.eq r15.is_active true;
    get usersdata[r4] into r20;
    assert.eq r19.is_freezed false;
    assert.eq r20.health_factor_below_threshold true;
    get.or_use amm_reserve_state_v003.aleo/deposited_amount[r9] 0u128 into r21;
    cast 1000000000000000000u128 1000000000000000000u128 into r22 as UserCumulativeIndex;
    get.or_use amm_reserve_state_v003.aleo/user_cumulative_index[r9] r22 into r23;
    pow 10u128 r19.decimals into r24;
    div 1000000000000000000u128 r24 into r25;
