    get.or_use amm_reserve_state_v003.aleo/borrowed_amount[r11] 0u128 into r51;
    gt r50 0u128 into r52;
    assert.eq r52 true;
    gt r51 0u128 into r53;
    assert.eq r53 true;
    cast r20.total_borrow_balance_USD into r54 as i128;
    div r20.total_collateral_balance_USD 1000000000000000000u128 into r55;
    div r20.current_LTV 1000000000000000000u128 into r56;
    rem r20.total_collateral_balance_USD 1000000000000000000u128 into r57;
    rem r20.current_LTV 1000000000000000000u128 into r58;
