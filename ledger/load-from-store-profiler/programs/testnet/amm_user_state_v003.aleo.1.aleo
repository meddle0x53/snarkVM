import amm_oracle_v003.aleo;
import amm_reserve_state_v003.aleo;

program amm_user_state_v003.aleo;

record UserSalt:
    owner as address.private;
    salt as field.private;

struct ReserveData:
    last_update_block_height as u32;
    liquidity_rate as u128;
    borrow_rate as u128;
    liquidity_cumulative_index as u128;
    borrow_cumulative_index as u128;

struct UserTokenKey:
    user_key as field;
    token_id as field;

struct ReserveConfig:
    token_id as field;
    decimals as u8;
    borrow_fee_percentage as u128;
    base_LTV_as_collateral as u128;
    liquidation_threshold as u128;
    liquidation_bonus as u128;
    optimal_utilization_rate as u128;
    base_borrow_rate as u128;
    borrow_threshold as u128;
    is_freezed as boolean;
    is_active as boolean;

struct UserCumulativeIndex:
    deposit as u128;
    borrow as u128;

struct UserData:
    last_updated_block_height as u32;
    total_liquidity_balance_USD as u128;
    total_collateral_balance_USD as u128;
    total_borrow_balance_USD as u128;
    avaialble_borrow_USD as u128;
    current_LTV as u128;
    current_liquidation_threshold as u128;
    borrowing_power as u128;
    health_factor_below_threshold as boolean;
    collateral_needed_in_USD as u128;
    hf_withdraw_below_threshold as boolean;

struct LiquidationKey:
    liquidator as field;
    liquidating as field;

struct LiquidationData:
    purchase_amount as u128;
    actual_amount_to_liquidate as u128;
    collateral_to_liquidate as u128;
    max_collateral_to_liquidate as u128;
    third_party_claimed as boolean;

mapping allowed_programs:
    key as address.public;
    value as boolean.public;

mapping admin:
    key as boolean.public;
    value as address.public;

mapping usersdata:
    key as field.public;
    value as UserData.public;

mapping liquidationsdata:
    key as LiquidationKey.public;
    value as LiquidationData.public;

function initialize:
    async initialize self.caller into r0;
    output r0 as amm_user_state_v003.aleo/initialize.future;

finalize initialize:
    input r0 as address.public;
    set r0 into admin[true];

function claim_liquidation:
    input r0 as u128.private;
    input r1 as u128.private;
    input r2 as u128.private;
    input r3 as u128.private;
    input r4 as boolean.private;
    input r5 as field.private;
    input r6 as field.private;
    input r7 as field.private;
    input r8 as field.private;
    cast r7 r6 into r9 as UserTokenKey;
    hash.bhp256 r9 into r10 as field;
    cast r8 r5 into r11 as UserTokenKey;
    hash.bhp256 r11 into r12 as field;
    async claim_liquidation self.caller r0 r1 r2 r3 r4 r10 r12 into r13;
    output r13 as amm_user_state_v003.aleo/claim_liquidation.future;

finalize claim_liquidation:
    input r0 as address.public;
    input r1 as u128.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as boolean.public;
    input r6 as field.public;
    input r7 as field.public;
    get allowed_programs[r0] into r8;
    assert.eq r8 true;
    cast r6 r7 into r9 as LiquidationKey;
    get liquidationsdata[r9] into r10;
    cast r1 r2 r3 r4 r5 into r11 as LiquidationData;
    assert.eq r10 r11;
    cast 0u128 0u128 0u128 0u128 false into r12 as LiquidationData;
    set r12 into liquidationsdata[r9];

function update_program_status:
    input r0 as address.private;
    input r1 as boolean.private;
    async update_program_status self.caller r0 r1 into r2;
    output r2 as amm_user_state_v003.aleo/update_program_status.future;

finalize update_program_status:
    input r0 as address.public;
    input r1 as address.public;
    input r2 as boolean.public;
    get admin[true] into r3;
    assert.eq r0 r3;
    is.eq r2 true into r4;
    branch.eq r4 false to end_then_0_0;
    set true into allowed_programs[r1];
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    remove allowed_programs[r1];
    position end_otherwise_0_1;

function create_salt_record:
    input r0 as field.private;
    cast self.signer r0 into r1 as UserSalt.record;
    output r1 as UserSalt.record;

function update_user_data:
