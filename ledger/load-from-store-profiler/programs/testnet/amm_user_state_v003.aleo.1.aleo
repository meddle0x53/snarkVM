    mul r103 r105 into r108;
    mul r104 r107 into r109;
    add r108 r109 into r110;
    mul r106 r107 into r111;
    div r111 1000000000000000000u128 into r112;
    add r110 r112 into r113;
    add 1000000000000000000u128 r19.liquidation_bonus into r114;
    div r113 1000000000000000000u128 into r115;
    div r114 1000000000000000000u128 into r116;
    rem r113 1000000000000000000u128 into r117;
    rem r114 1000000000000000000u128 into r118;
    mul r113 r116 into r119;
    mul r115 r118 into r120;
    add r119 r120 into r121;
    mul r117 r118 into r122;
    div r122 1000000000000000000u128 into r123;
    add r121 r123 into r124;
    is.eq r71 0u128 into r125;
    ternary r125 1000000000000000000u128 r71 into r126;
    mul r124 1000000000u128 into r127;
    div r127 r126 into r128;
    rem r127 r126 into r129;
    mul r129 1000000000u128 into r130;
    div r130 r126 into r131;
    rem r130 r126 into r132;
    mul r128 1000000000u128 into r133;
