    output r2 as amm_user_state_v003.aleo/update_user_timestamp.future;

finalize update_user_timestamp:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    get allowed_programs[r0] into r3;
    assert.eq r3 true;
    get usersdata[r2] into r4;
    cast block.height r4.total_liquidity_balance_USD r4.total_collateral_balance_USD r4.total_borrow_balance_USD r4.avaialble_borrow_USD r4.current_LTV r4.current_liquidation_threshold r4.borrowing_power r4.health_factor_below_threshold r4.collateral_needed_in_USD r4.hf_withdraw_below_threshold into r5 as UserData;
    set r5 into usersdata[r2];
