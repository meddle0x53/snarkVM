    add r149 r147 into r150;
    ternary r141 0u128 r150 into r151;
    is.eq r70 0u128 into r152;
    ternary r152 1000000000000000000u128 r70 into r153;
    mul r151 1000000000u128 into r154;
    div r154 r153 into r155;
