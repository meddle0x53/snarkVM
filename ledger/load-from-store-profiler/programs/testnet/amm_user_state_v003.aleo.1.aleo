function claim_liq_3rd_party:
    input r0 as u128.private;
    input r1 as u128.private;
    input r2 as u128.private;
    input r3 as u128.private;
    input r4 as boolean.private;
    input r5 as field.private;
    input r6 as field.private;
    not r4 into r7;
    assert.eq r7 true;
    cast r5 r6 into r8 as UserTokenKey;
    hash.bhp256 r8 into r9 as field;
    cast r6 r5 into r10 as UserTokenKey;
    hash.bhp256 r10 into r11 as field;
    async claim_liq_3rd_party self.caller r0 r1 r2 r3 r4 r9 r11 into r12;
    output r12 as amm_user_state_v003.aleo/claim_liq_3rd_party.future;

finalize claim_liq_3rd_party:
    input r0 as address.public;
    input r1 as u128.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as boolean.public;
    input r6 as field.public;
    input r7 as field.public;
    get allowed_programs[r0] into r8;
    assert.eq r8 true;
    cast r6 r7 into r9 as LiquidationKey;
    get liquidationsdata[r9] into r10;
    cast r1 r2 r3 r4 r5 into r11 as LiquidationData;
    assert.eq r10 r11;
    cast r10.purchase_amount r10.actual_amount_to_liquidate r10.collateral_to_liquidate r10.max_collateral_to_liquidate true into r12 as LiquidationData;
    set r12 into liquidationsdata[r9];

function check_on_liquidation:
    input r0 as field.private;
    input r1 as field.private;
    input r2 as field.private;
