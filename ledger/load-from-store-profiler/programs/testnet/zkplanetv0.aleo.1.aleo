function place_extractor:
    input r0 as u8.private;
    input r1 as u8.private;
    input r2 as u8.private;
    input r3 as Board.private;
    input r4 as PlayerState.record;
    gte r4.gold_total 10u32 into r5;
    assert.eq r5 true;
    lte 1u8 r0 into r6;
    lte r0 3u8 into r7;
    and r6 r7 into r8;
    assert.eq r8 true;
    lte 1u8 r1 into r9;
    lte r1 3u8 into r10;
    and r9 r10 into r11;
    assert.eq r11 true;
    call get_plot r3 r0 r1 into r12;
    not r12.has_extractor into r13;
    assert.eq r13 true;
    is.eq r2 1u8 into r14;
    add r4.iron_total r12.iron into r15;
    ternary r14 r15 r4.iron_total into r16;
    is.eq r2 2u8 into r17;
    add r4.gold_total r12.gold into r18;
    sub r18 10u32 into r19;
    sub r4.gold_total 10u32 into r20;
    ternary r17 r19 r20 into r21;
    is.eq r2 3u8 into r22;
    add r4.water_total r12.water into r23;
    ternary r22 r23 r4.water_total into r24;
    cast r4.owner r16 r21 r24 r4.population_total into r25 as PlayerState.record;
    cast r12.iron r12.gold r12.water r12.population true r12.has_habitat into r26 as Plot;
    call update_plot r3 r0 r1 r26 into r27;
    output r27 as Board.private;
    output r25 as PlayerState.record;

function place_habitat:
    input r0 as u8.private;
    input r1 as u8.private;
    input r2 as Board.private;
    input r3 as PlayerState.record;
    gte r3.water_total 10u32 into r4;
    assert.eq r4 true;
    gte r3.gold_total 10u32 into r5;
    assert.eq r5 true;
    gte r3.iron_total 10u32 into r6;
    assert.eq r6 true;
    lte 1u8 r0 into r7;
    lte r0 3u8 into r8;
    and r7 r8 into r9;
    assert.eq r9 true;
    lte 1u8 r1 into r10;
    lte r1 3u8 into r11;
    and r10 r11 into r12;
    assert.eq r12 true;
    call get_plot r2 r0 r1 into r13;
    not r13.has_habitat into r14;
    assert.eq r14 true;
    sub r3.iron_total 10u32 into r15;
    sub r3.gold_total 10u32 into r16;
    sub r3.water_total 10u32 into r17;
    add r3.population_total 25u32 into r18;
    cast r3.owner r15 r16 r17 r18 into r19 as PlayerState.record;
    cast r13.iron r13.gold r13.water r13.population r13.has_extractor true into r20 as Plot;
    call update_plot r2 r0 r1 r20 into r21;
    output r21 as Board.private;
    output r19 as PlayerState.record;

function propose_trade:
    input r0 as address.private;
    input r1 as u32.private;
    input r2 as u32.private;
    input r3 as u32.private;
    input r4 as u32.private;
    input r5 as u32.private;
    input r6 as u32.private;
    input r7 as PlayerState.record;
    gte r7.iron_total r4 into r8;
    assert.eq r8 true;
    gte r7.gold_total r5 into r9;
    assert.eq r9 true;
    gte r7.water_total r6 into r10;
    assert.eq r10 true;
    cast r0 self.caller r0 r1 r2 r3 r4 r5 r6 false into r11 as Trade.record;
    output r11 as Trade.record;

function accept_trade:
    input r0 as Trade.record;
    input r1 as PlayerState.record;
    input r2 as PlayerState.record;
    not r0.is_completed into r3;
    assert.eq r3 true;
    is.eq r0.owner self.caller into r4;
    assert.eq r4 true;
    gte r2.iron_total r0.requested_iron into r5;
    assert.eq r5 true;
    gte r2.gold_total r0.requested_gold into r6;
    assert.eq r6 true;
    gte r2.water_total r0.requested_water into r7;
    assert.eq r7 true;
    sub r1.iron_total r0.offered_iron into r8;
    add r8 r0.requested_iron into r9;
    sub r1.gold_total r0.offered_gold into r10;
    add r10 r0.requested_gold into r11;
    sub r1.water_total r0.offered_water into r12;
    add r12 r0.requested_water into r13;
    cast r1.owner r9 r11 r13 r1.population_total into r14 as PlayerState.record;
    add r2.iron_total r0.offered_iron into r15;
    sub r15 r0.requested_iron into r16;
    add r2.gold_total r0.offered_gold into r17;
    sub r17 r0.requested_gold into r18;
    add r2.water_total r0.offered_water into r19;
    sub r19 r0.requested_water into r20;
    cast r2.owner r16 r18 r20 r2.population_total into r21 as PlayerState.record;
    output r14 as PlayerState.record;
    output r21 as PlayerState.record;
