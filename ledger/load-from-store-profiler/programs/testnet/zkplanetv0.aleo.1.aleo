program zkplanetv0.aleo;

struct Plot:
    iron as u32;
    gold as u32;
    water as u32;
    population as u32;
    has_extractor as boolean;
    has_habitat as boolean;

struct Row:
    c1 as Plot;
    c2 as Plot;
    c3 as Plot;

struct Board:
    r1 as Row;
    r2 as Row;
    r3 as Row;

record PlayerState:
    owner as address.private;
    iron_total as u32.private;
    gold_total as u32.private;
    water_total as u32.private;
    population_total as u32.private;

record Trade:
    owner as address.private;
    sender as address.private;
    receiver as address.private;
    requested_iron as u32.private;
    requested_gold as u32.private;
    requested_water as u32.private;
    offered_iron as u32.private;
    offered_gold as u32.private;
    offered_water as u32.private;
    is_completed as boolean.private;

mapping generated_plots:
    key as u8.public;
    value as Plot.public;

