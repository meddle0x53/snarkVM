import credits.aleo;

program batch_test_loop.aleo;

function payroll_private:
    input r0 as [u64; 25u32].private;
    input r1 as [address; 25u32].private;
    input r2 as u64.private;
    call credits.aleo/transfer_public_to_private self.signer r2 into r3 r4;
    call credits.aleo/transfer_public_as_signer batch_test_loop.aleo r2 into r5;
    is.neq r0[0u32] 0u64 into r6;
    assert.eq r6 true;
    call credits.aleo/transfer_private r3 r1[0u32] r0[0u32] into r7 r8;
    is.neq r0[1u32] 0u64 into r9;
    assert.eq r9 true;
    call credits.aleo/transfer_private r8 r1[1u32] r0[1u32] into r10 r11;
    is.neq r0[2u32] 0u64 into r12;
    assert.eq r12 true;
    call credits.aleo/transfer_private r11 r1[2u32] r0[2u32] into r13 r14;
    is.neq r0[3u32] 0u64 into r15;
    assert.eq r15 true;
    call credits.aleo/transfer_private r14 r1[3u32] r0[3u32] into r16 r17;
    is.neq r0[4u32] 0u64 into r18;
    assert.eq r18 true;
    call credits.aleo/transfer_private r17 r1[4u32] r0[4u32] into r19 r20;
    is.neq r0[5u32] 0u64 into r21;
    assert.eq r21 true;
    call credits.aleo/transfer_private r20 r1[5u32] r0[5u32] into r22 r23;
    is.neq r0[6u32] 0u64 into r24;
    assert.eq r24 true;
    call credits.aleo/transfer_private r23 r1[6u32] r0[6u32] into r25 r26;
    is.neq r0[7u32] 0u64 into r27;
    assert.eq r27 true;
    call credits.aleo/transfer_private r26 r1[7u32] r0[7u32] into r28 r29;
    is.neq r0[8u32] 0u64 into r30;
    assert.eq r30 true;
    call credits.aleo/transfer_private r29 r1[8u32] r0[8u32] into r31 r32;
    is.neq r0[9u32] 0u64 into r33;
    assert.eq r33 true;
    call credits.aleo/transfer_private r32 r1[9u32] r0[9u32] into r34 r35;
    is.neq r0[10u32] 0u64 into r36;
    assert.eq r36 true;
    call credits.aleo/transfer_private r35 r1[10u32] r0[10u32] into r37 r38;
    is.neq r0[11u32] 0u64 into r39;
    assert.eq r39 true;
    call credits.aleo/transfer_private r38 r1[11u32] r0[11u32] into r40 r41;
    is.neq r0[12u32] 0u64 into r42;
    assert.eq r42 true;
    call credits.aleo/transfer_private r41 r1[12u32] r0[12u32] into r43 r44;
    is.neq r0[13u32] 0u64 into r45;
    assert.eq r45 true;
    call credits.aleo/transfer_private r44 r1[13u32] r0[13u32] into r46 r47;
    is.neq r0[14u32] 0u64 into r48;
    assert.eq r48 true;
    call credits.aleo/transfer_private r47 r1[14u32] r0[14u32] into r49 r50;
    is.neq r0[15u32] 0u64 into r51;
    assert.eq r51 true;
    call credits.aleo/transfer_private r50 r1[15u32] r0[15u32] into r52 r53;
    is.neq r0[16u32] 0u64 into r54;
    assert.eq r54 true;
    call credits.aleo/transfer_private r53 r1[16u32] r0[16u32] into r55 r56;
    is.neq r0[17u32] 0u64 into r57;
    assert.eq r57 true;
    call credits.aleo/transfer_private r56 r1[17u32] r0[17u32] into r58 r59;
    is.neq r0[18u32] 0u64 into r60;
    assert.eq r60 true;
    call credits.aleo/transfer_private r59 r1[18u32] r0[18u32] into r61 r62;
    is.neq r0[19u32] 0u64 into r63;
    assert.eq r63 true;
    call credits.aleo/transfer_private r62 r1[19u32] r0[19u32] into r64 r65;
    is.neq r0[20u32] 0u64 into r66;
    assert.eq r66 true;
    call credits.aleo/transfer_private r65 r1[20u32] r0[20u32] into r67 r68;
    is.neq r0[21u32] 0u64 into r69;
    assert.eq r69 true;
    call credits.aleo/transfer_private r68 r1[21u32] r0[21u32] into r70 r71;
    is.neq r0[22u32] 0u64 into r72;
    assert.eq r72 true;
    call credits.aleo/transfer_private r71 r1[22u32] r0[22u32] into r73 r74;
    is.neq r0[23u32] 0u64 into r75;
    assert.eq r75 true;
    call credits.aleo/transfer_private r74 r1[23u32] r0[23u32] into r76 r77;
    is.neq r0[24u32] 0u64 into r78;
    assert.eq r78 true;
    call credits.aleo/transfer_private r77 r1[24u32] r0[24u32] into r79 r80;
    async payroll_private r4 r5 into r81;
    output r81 as batch_test_loop.aleo/payroll_private.future;

finalize payroll_private:
    input r0 as credits.aleo/transfer_public_to_private.future;
    input r1 as credits.aleo/transfer_public_as_signer.future;
    await r0;
    await r1;
