import credits.aleo;
import token_registry.aleo;
import test_token.aleo;

program test_swap.aleo;

struct TokenMetadata:
    token_id as field;
    name as u128;
    symbol as u128;
    decimals as u8;
    supply as u128;
    max_supply as u128;
    admin as address;
    external_authorization_required as boolean;
    external_authorization_party as address;

struct TokenOwner:
    account as address;
    token_id as field;

struct BalanceKeyData:
    token as field;
    user as address;

struct Pair:
    reserve_a as u128;
    reserve_b as u128;

struct PairKeyData:
    token_a as field;
    token_b as field;

mapping pairs:
    key as field.public;
    value as Pair.public;

mapping balances:
    key as field.public;
    value as u128.public;

function create_pair:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    gt r2 0u128 into r4;
    assert.eq r4 true;
    gt r3 0u128 into r5;
    assert.eq r5 true;
    call token_registry.aleo/approve_public r0 test_swap.aleo r2 into r6;
    call token_registry.aleo/approve_public r1 test_swap.aleo r3 into r7;
    call token_registry.aleo/transfer_from_public r0 self.caller test_swap.aleo r2 into r8;
    call token_registry.aleo/transfer_from_public r1 self.caller test_swap.aleo r3 into r9;
    lt r0 r1 into r10;
    assert.eq r10 true;
    cast r0 r1 into r11 as PairKeyData;
    hash.bhp256 r11 into r12 as field;
    mul r2 r3 into r13;
    is.eq r13 0u128 into r14;
    shr r13 64u32 into r15;
    gt r15 0u128 into r16;
    shr r13 64u32 into r17;
    add 0u32 64u32 into r18;
    ternary r16 r17 r13 into r19;
    ternary r16 r18 0u32 into r20;
    shr r19 32u32 into r21;
    gt r21 0u128 into r22;
    shr r19 32u32 into r23;
    add r20 32u32 into r24;
    ternary r22 r23 r19 into r25;
    ternary r22 r24 r20 into r26;
    shr r25 16u32 into r27;
    gt r27 0u128 into r28;
    shr r25 16u32 into r29;
    add r26 16u32 into r30;
    ternary r28 r29 r25 into r31;
    ternary r28 r30 r26 into r32;
    shr r31 8u32 into r33;
    gt r33 0u128 into r34;
    shr r31 8u32 into r35;
    add r32 8u32 into r36;
    ternary r34 r35 r31 into r37;
    ternary r34 r36 r32 into r38;
    shr r37 4u32 into r39;
    gt r39 0u128 into r40;
    shr r37 4u32 into r41;
    add r38 4u32 into r42;
    ternary r40 r41 r37 into r43;
    ternary r40 r42 r38 into r44;
    shr r43 2u32 into r45;
    gt r45 0u128 into r46;
    shr r43 2u32 into r47;
    add r44 2u32 into r48;
    ternary r46 r47 r43 into r49;
    ternary r46 r48 r44 into r50;
    shr r49 1u32 into r51;
    gt r51 0u128 into r52;
    add r50 1u32 into r53;
    ternary r52 r53 r50 into r54;
    div r54 2u32 into r55;
    shl 1u128 r55 into r56;
    div r13 r56 into r57;
    add r56 r57 into r58;
    shr r58 1u32 into r59;
    div r13 r59 into r60;
    add r59 r60 into r61;
    shr r61 1u32 into r62;
    div r13 r62 into r63;
    add r62 r63 into r64;
    shr r64 1u32 into r65;
    div r13 r65 into r66;
    add r65 r66 into r67;
    shr r67 1u32 into r68;
    div r13 r68 into r69;
    add r68 r69 into r70;
    shr r70 1u32 into r71;
    div r13 r71 into r72;
    add r71 r72 into r73;
    shr r73 1u32 into r74;
    div r13 r74 into r75;
    add r74 r75 into r76;
    shr r76 1u32 into r77;
    div r13 r77 into r78;
    lt r77 r78 into r79;
    ternary r79 r77 r78 into r80;
    ternary r14 0u128 r80 into r81;
    call test_token.aleo/register_token r12 into r82;
    cast r81 into r83 as u128;
    call token_registry.aleo/mint_public r12 self.caller r83 4294967295u32 into r84;
    cast r81 into r85 as u128;
    async create_pair r0 r1 r2 r3 r85 r12 self.caller r6 r7 r8 r9 r82 r84 into r86;
    output r86 as test_swap.aleo/create_pair.future;

finalize create_pair:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as field.public;
    input r6 as address.public;
    input r7 as token_registry.aleo/approve_public.future;
    input r8 as token_registry.aleo/approve_public.future;
    input r9 as token_registry.aleo/transfer_from_public.future;
    input r10 as token_registry.aleo/transfer_from_public.future;
    input r11 as test_token.aleo/register_token.future;
    input r12 as token_registry.aleo/mint_public.future;
    await r7;
    await r8;
    await r9;
    await r10;
    await r11;
    await r12;
    gt r4 0u128 into r13;
    assert.eq r13 true;
    cast r5 1414743380u128 5526356u128 6u8 0u128 10000000000000000u128 test_token.aleo false test_swap.aleo into r14 as TokenMetadata;
    get.or_use token_registry.aleo/registered_tokens[r5] r14 into r15;
    assert.eq r15.supply 0u128;
    cast 0u128 0u128 into r16 as Pair;
    get.or_use pairs[r5] r16 into r17;
    cast r5 r6 into r18 as BalanceKeyData;
    hash.bhp256 r18 into r19 as field;
    get.or_use balances[r19] 0u128 into r20;
    add r20 r4 into r21;
    set r21 into balances[r19];
    add r17.reserve_a r2 into r22;
    add r17.reserve_b r3 into r23;
    cast r22 r23 into r24 as Pair;
    set r24 into pairs[r5];

function add_liquidity:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as u128.public;
    input r6 as u128.public;
    gt r2 0u128 into r7;
    assert.eq r7 true;
    gt r3 0u128 into r8;
    assert.eq r8 true;
    call token_registry.aleo/approve_public r0 test_swap.aleo r2 into r9;
    call token_registry.aleo/approve_public r1 test_swap.aleo r3 into r10;
    call token_registry.aleo/transfer_from_public r0 self.caller test_swap.aleo r2 into r11;
    call token_registry.aleo/transfer_from_public r1 self.caller test_swap.aleo r3 into r12;
    lt r0 r1 into r13;
    assert.eq r13 true;
    cast r0 r1 into r14 as PairKeyData;
    hash.bhp256 r14 into r15 as field;
    mul r2 r4 into r16;
    div r16 r5 into r17;
    mul r3 r4 into r18;
    div r18 r6 into r19;
    lte r17 r19 into r20;
    ternary r20 r17 r19 into r21;
    call token_registry.aleo/mint_public r15 self.caller r21 4294967295u32 into r22;
    async add_liquidity r0 r1 r5 r6 r4 r21 r2 r3 r15 self.caller r9 r10 r11 r12 r22 into r23;
    output r23 as test_swap.aleo/add_liquidity.future;

finalize add_liquidity:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as u128.public;
    input r6 as u128.public;
    input r7 as u128.public;
    input r8 as field.public;
    input r9 as address.public;
    input r10 as token_registry.aleo/approve_public.future;
    input r11 as token_registry.aleo/approve_public.future;
    input r12 as token_registry.aleo/transfer_from_public.future;
    input r13 as token_registry.aleo/transfer_from_public.future;
    input r14 as token_registry.aleo/mint_public.future;
    await r10;
    await r11;
    await r12;
    await r13;
    await r14;
    get pairs[r8] into r15;
    get token_registry.aleo/registered_tokens[r8] into r16;
    assert.eq r2 r15.reserve_a;
    assert.eq r3 r15.reserve_b;
    assert.eq r4 r16.supply;
    mul r6 r4 into r17;
    div r17 r2 into r18;
    mul r7 r4 into r19;
    div r19 r3 into r20;
    lte r18 r5 into r21;
    mul r5 r2 into r22;
    add r22 r16.supply into r23;
    sub r23 1u128 into r24;
    div r24 r16.supply into r25;
    ternary r21 r6 r25 into r26;
    lte r20 r5 into r27;
    mul r5 r3 into r28;
    add r28 r16.supply into r29;
    sub r29 1u128 into r30;
    div r30 r16.supply into r31;
    ternary r27 r7 r31 into r32;
    gt r5 0u128 into r33;
    assert.eq r33 true;
    cast r8 r9 into r34 as BalanceKeyData;
    hash.bhp256 r34 into r35 as field;
    get.or_use balances[r35] 0u128 into r36;
    add r36 r5 into r37;
    set r37 into balances[r35];
    add r15.reserve_a r26 into r38;
    add r15.reserve_b r32 into r39;
    cast r38 r39 into r40 as Pair;
    set r40 into pairs[r8];

function remove_liquidity:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as u128.public;
    input r6 as u128.public;
    input r7 as u128.public;
    input r8 as address.public;
    gt r4 0u128 into r9;
    assert.eq r9 true;
    call token_registry.aleo/transfer_from_public r0 test_swap.aleo self.caller r2 into r10;
    call token_registry.aleo/transfer_from_public r1 test_swap.aleo self.caller r3 into r11;
    lt r0 r1 into r12;
    assert.eq r12 true;
    cast r0 r1 into r13 as PairKeyData;
    hash.bhp256 r13 into r14 as field;
    call token_registry.aleo/burn_public r14 self.caller r4 into r15;
    async remove_liquidity self.caller r14 r0 r1 r6 r7 r4 r5 r8 r10 r11 r15 into r16;
    output r16 as test_swap.aleo/remove_liquidity.future;

finalize remove_liquidity:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u128.public;
    input r5 as u128.public;
    input r6 as u128.public;
    input r7 as u128.public;
    input r8 as address.public;
    input r9 as token_registry.aleo/transfer_from_public.future;
    input r10 as token_registry.aleo/transfer_from_public.future;
    input r11 as token_registry.aleo/burn_public.future;
    await r9;
    await r10;
    await r11;
    get pairs[r1] into r12;
    get token_registry.aleo/registered_tokens[r1] into r13;
    assert.eq r4 r12.reserve_a;
    assert.eq r5 r12.reserve_b;
    assert.eq r7 r13.supply;
    cast r1 r8 into r14 as BalanceKeyData;
    hash.bhp256 r14 into r15 as field;
    get balances[r15] into r16;
    mul r6 r4 into r17;
    div r17 r7 into r18;
    mul r6 r5 into r19;
    div r19 r7 into r20;
    gt r18 0u128 into r21;
    gt r20 0u128 into r22;
    or r21 r22 into r23;
    assert.eq r23 true;
    get balances[r15] into r24;
    sub r24 r6 into r25;
    set r25 into balances[r15];
    sub r12.reserve_a r18 into r26;
    sub r12.reserve_b r20 into r27;
    cast r26 r27 into r28 as Pair;
    set r28 into pairs[r1];

function swap_exact_tokens_for_tokens:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as u128.public;
    input r4 as u128.public;
    input r5 as address.public;
    is.neq r0 r1 into r6;
    assert.eq r6 true;
    gt r2 0u128 into r7;
    assert.eq r7 true;
    lt r0 r1 into r8;
    ternary r8 r0 r1 into r9;
    lt r0 r1 into r10;
    ternary r10 r1 r0 into r11;
    is.eq r9 r0 into r12;
    ternary r12 r3 r4 into r13;
    is.eq r9 r1 into r14;
    ternary r14 r3 r4 into r15;
    mul r2 r15 into r16;
    mul r13 1000u128 into r17;
    div r16 r17 into r18;
    gt r18 0u128 into r19;
    assert.eq r19 true;
    call token_registry.aleo/approve_public r0 test_swap.aleo r2 into r20;
    call token_registry.aleo/transfer_from_public r0 self.caller test_swap.aleo r2 into r21;
    call token_registry.aleo/transfer_from_public r1 test_swap.aleo self.caller r18 into r22;
    lt r9 r11 into r23;
    assert.eq r23 true;
    cast r9 r11 into r24 as PairKeyData;
    hash.bhp256 r24 into r25 as field;
    async swap_exact_tokens_for_tokens self.caller r25 r0 r1 r2 r18 r13 r15 r5 r20 r21 r22 into r26;
    output r26 as test_swap.aleo/swap_exact_tokens_for_tokens.future;

finalize swap_exact_tokens_for_tokens:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u128.public;
    input r5 as u128.public;
    input r6 as u128.public;
    input r7 as u128.public;
    input r8 as address.public;
    input r9 as token_registry.aleo/approve_public.future;
    input r10 as token_registry.aleo/transfer_from_public.future;
    input r11 as token_registry.aleo/transfer_from_public.future;
    await r9;
    await r10;
    await r11;
    lt r2 r3 into r12;
    ternary r12 r2 r3 into r13;
    lt r2 r3 into r14;
    ternary r14 r3 r2 into r15;
    get pairs[r1] into r16;
    cast r2 r0 into r17 as BalanceKeyData;
    hash.bhp256 r17 into r18 as field;
    get balances[r18] into r19;
    sub r19 r4 into r20;
    set r20 into balances[r18];
    add r6 r4 into r21;
    sub r7 r5 into r22;
    is.eq r13 r2 into r23;
    ternary r23 r21 r22 into r24;
    is.eq r15 r2 into r25;
    ternary r25 r21 r22 into r26;
    cast r24 r26 into r27 as Pair;
    set r27 into pairs[r1];
    cast r3 r8 into r28 as BalanceKeyData;
    hash.bhp256 r28 into r29 as field;
    get.or_use balances[r29] 0u128 into r30;
    add r30 r5 into r31;
    set r31 into balances[r29];
