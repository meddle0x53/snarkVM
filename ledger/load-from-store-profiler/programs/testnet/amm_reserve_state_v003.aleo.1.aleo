    div r23 1000000000000000000u128 into r24;
    add r22 r24 into r25;
    is.eq r11.deposit 0u128 into r26;
    ternary r26 1000000000000000000u128 r11.deposit into r27;
    mul r25 1000000000u128 into r28;
    div r28 r27 into r29;
    rem r28 r27 into r30;
    mul r30 1000000000u128 into r31;
    div r31 r27 into r32;
    rem r31 r27 into r33;
    mul r29 1000000000u128 into r34;
    add r34 r32 into r35;
    ternary r26 0u128 r35 into r36;
    pow 10u128 r8.decimals into r37;
    div 1000000000000000000u128 r37 into r38;
    div r36 r38 into r39;
    sub r39 r12 into r40;
    gte r39 r3 into r41;
    cast r39 into r42 as i128;
    cast r3 into r43 as i128;
    sub r42 r43 into r44;
    ternary r41 r44 0i128 into r45;
    cast r45 into r46 as u128;
    ternary r4 r46 0u128 into r47;
    ternary r4 r39 r3 into r48;
    get.or_use total_available_liquidity[r1] 0u128 into r49;
    sub r49 r48 into r50;
    add r50 r40 into r51;
    get.or_use total_deposited_amount[r1] 0u128 into r52;
    sub r52 r48 into r53;
    add r53 r40 into r54;
    set r54 into total_deposited_amount[r1];
    add r12 r40 into r55;
    sub r55 r48 into r56;
    set r56 into deposited_amount[r2];
    set r51 into total_available_liquidity[r1];
    cast r7.liquidity_cumulative_index r11.borrow into r57 as UserCumulativeIndex;
    set r57 into user_cumulative_index[r2];
    get.or_use pending_claims_withdraw[r2] 0u128 into r58;
    add r58 r47 into r59;
    set r59 into pending_claims_withdraw[r2];

