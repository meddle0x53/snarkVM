    value as u128.public;

mapping borrowed_amount:
    key as field.public;
    value as u128.public;

mapping total_deposited_amount:
    key as field.public;
    value as u128.public;

mapping deposited_amount:
    key as field.public;
    value as u128.public;

mapping total_available_liquidity:
    key as field.public;
    value as u128.public;

mapping allowed_programs:
    key as address.public;
    value as boolean.public;

mapping admin:
    key as boolean.public;
    value as address.public;

mapping slope_rate1:
    key as field.public;
    value as u128.public;

mapping slope_rate2:
    key as field.public;
    value as u128.public;

mapping instant_cbi:
    key as field.public;
    value as u128.public;

mapping user_cumulative_index:
    key as field.public;
    value as UserCumulativeIndex.public;

mapping temp_liq_reserve_amt:
    key as field.public;
    value as u128.public;

mapping temp_liq_collateral_amt:
    key as field.public;
    value as u128.public;

mapping allowed_tokens:
    key as field.public;
    value as boolean.public;

function initialize:
    async initialize self.caller into r0;
    output r0 as amm_reserve_state_v003.aleo/initialize.future;

finalize initialize:
    input r0 as address.public;
    set r0 into admin[true];

function add_reserve:
    input r0 as field.private;
    input r1 as u128.private;
    input r2 as u128.private;
    input r3 as u128.private;
    input r4 as u128.private;
    input r5 as u128.private;
    input r6 as u8.private;
    input r7 as u128.private;
    input r8 as u128.private;
    input r9 as u128.private;
    input r10 as boolean.private;
    input r11 as boolean.private;
    input r12 as u128.private;
    cast 0u32 0u128 0u128 r1 r2 into r13 as ReserveData;
    cast r0 r6 r7 r3 r4 r5 r8 r9 r12 r10 r11 into r14 as ReserveConfig;
    async add_reserve self.caller r0 r13 r14 into r15;
    output r15 as amm_reserve_state_v003.aleo/add_reserve.future;

finalize add_reserve:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as ReserveData.public;
    input r3 as ReserveConfig.public;
    get admin[true] into r4;
    assert.eq r0 r4;
    set r2 into reserve_data[r1];
    set r3 into reserve_config[r1];

