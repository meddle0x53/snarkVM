function update_user_liquidation:
    input r0 as field.private;
    input r1 as field.private;
    input r2 as field.private;
    input r3 as field.private;
    input r4 as u128.private;
    input r5 as u128.private;
    cast r2 r0 into r6 as UserTokenKey;
    hash.bhp256 r6 into r7 as field;
    cast r2 r1 into r8 as UserTokenKey;
    hash.bhp256 r8 into r9 as field;
    async update_user_liquidation self.caller r0 r1 r7 r9 r4 r5 into r10;
    output r10 as amm_reserve_state_v003.aleo/update_user_liquidation.future;

