program amm_reserve_state_v003.aleo;

struct ReserveData:
    last_update_block_height as u32;
    liquidity_rate as u128;
    borrow_rate as u128;
    liquidity_cumulative_index as u128;
    borrow_cumulative_index as u128;

struct UserTokenKey:
    user_key as field;
    token_id as field;

struct ReserveConfig:
    token_id as field;
    decimals as u8;
    borrow_fee_percentage as u128;
    base_LTV_as_collateral as u128;
    liquidation_threshold as u128;
    liquidation_bonus as u128;
    optimal_utilization_rate as u128;
    base_borrow_rate as u128;
    borrow_threshold as u128;
    is_freezed as boolean;
    is_active as boolean;

struct UserCumulativeIndex:
    deposit as u128;
    borrow as u128;

mapping reserve_data:
    key as field.public;
    value as ReserveData.public;

mapping reserve_config:
    key as field.public;
    value as ReserveConfig.public;

mapping pending_claims_withdraw:
    key as field.public;
    value as u128.public;

mapping pending_claims_repay:
    key as field.public;
    value as u128.public;

mapping treasury_claims:
