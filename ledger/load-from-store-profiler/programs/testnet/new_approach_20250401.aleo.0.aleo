program new_approach_20250401.aleo;

struct Signer:
    addr as address;
    weight as u8;

struct SignerSet:
    signers as [[Signer; 32u32]; 2u32];
    quorum as u8;

mapping signer_sets:
    key as group.public;
    value as SignerSet.public;

mapping approved_message_batches:
    key as group.public;
    value as [[group; 16u32]; 12u32].public;

mapping executed_messages:
    key as group.public;
    value as boolean.public;

mapping signer_set_counter:
    key as u8.public;
    value as u8.public;

mapping signer_set_hash:
    key as u8.public;
    value as group.public;

mapping signer_set_index:
    key as group.public;
    value as u8.public;

mapping last_signer_rotation_height:
    key as u8.public;
    value as u32.public;

function main:
    assert.eq 1u8 1u8;

function approve_message_batch:
    input r0 as [[group; 16u32]; 12u32].private;
    input r1 as SignerSet.private;
    input r2 as [[signature; 32u32]; 2u32].private;
    async approve_message_batch r0 r1 r2 into r3;
    output r3 as new_approach_20250401.aleo/approve_message_batch.future;

