function approve_signer_set:
    input r0 as SignerSet.private;
    input r1 as SignerSet.private;
    input r2 as [[signature; 32u32]; 2u32].private;
    async approve_signer_set r0 r1 r2 into r3;
    output r3 as new_approach_20250401.aleo/approve_signer_set.future;

finalize approve_signer_set:
    input r0 as SignerSet.public;
    input r1 as SignerSet.public;
    input r2 as [[signature; 32u32]; 2u32].public;
    get.or_use last_signer_rotation_height[0u8] 0u32 into r3;
    sub block.height r3 into r4;
    gt r4 14400u32 into r5;
    assert.eq r5 true;
    set block.height into last_signer_rotation_height[0u8];
    hash.bhp256 r1 into r6 as group;
    contains signer_sets[r6] into r7;
    assert.eq r7 true;
    hash.bhp256 r0 into r8 as group;
    sign.verify r2[0u32][0u32] r1.signers[0u32][0u32].addr r8 into r9;
    add 0u8 r1.signers[0u32][0u32].weight into r10;
    gte r10 r1.quorum into r11;
    and r9 r11 into r12;
    ternary r9 r10 0u8 into r13;
    sign.verify r2[0u32][1u32] r1.signers[0u32][1u32].addr r8 into r14;
    add r13 r1.signers[0u32][1u32].weight into r15;
    gte r15 r1.quorum into r16;
    and r14 r16 into r17;
    ternary r14 r15 r13 into r18;
    sign.verify r2[0u32][2u32] r1.signers[0u32][2u32].addr r8 into r19;
    add r18 r1.signers[0u32][2u32].weight into r20;
    gte r20 r1.quorum into r21;
    and r19 r21 into r22;
    ternary r19 r20 r18 into r23;
    sign.verify r2[0u32][3u32] r1.signers[0u32][3u32].addr r8 into r24;
    add r23 r1.signers[0u32][3u32].weight into r25;
    gte r25 r1.quorum into r26;
