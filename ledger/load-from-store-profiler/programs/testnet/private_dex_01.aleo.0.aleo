function remove_liquidity:
    input r0 as u128.private;
    input r1 as u128.private;
    input r2 as field.private;
    input r3 as u128.private;
    input r4 as field.private;
    input r5 as u128.private;
    gt r3 0u128 into r6;
    assert.eq r6 true;
    gt r5 0u128 into r7;
    assert.eq r7 true;
    call multi_token_support_program.aleo/transfer_public r2 self.caller r3 into r8;
    call multi_token_support_program.aleo/transfer_public r4 self.caller r5 into r9;
    async remove_liquidity r0 r1 self.caller r2 r3 r4 r5 r8 r9 into r10;
    output r10 as private_dex_01.aleo/remove_liquidity.future;

