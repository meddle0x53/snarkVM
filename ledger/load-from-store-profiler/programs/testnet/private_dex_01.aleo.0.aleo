    input r6 as address.public;
    input r7 as multi_token_support_program.aleo/transfer_from_public.future;
    input r8 as multi_token_support_program.aleo/transfer_from_public.future;
    get self_address[true] into r9;
    is.eq r9 r6 into r10;
    assert.eq r10 true;
    contains pool_detail[r0] into r11;
    assert.eq r11 true;
    get pool_detail[r0] into r12;
    is.eq r12.pool_owner r5 into r13;
    assert.eq r13 true;
    is.eq r12.token1_name r1 into r14;
    assert.eq r14 true;
    is.eq r12.token2_name r3 into r15;
    assert.eq r15 true;
    is.eq r12.supply 0u128 into r16;
    mul r2 r4 into r17;
    gt r17 3u128 into r18;
    add 1u128 r17 into r19;
    div r19 2u128 into r20;
    mul.w r20 r20 into r21;
    lte r21 r17 into r22;
