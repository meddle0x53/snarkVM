import credits.aleo;
import multi_token_support_program.aleo;

program private_dex_01.aleo;

struct TokenMetadata:
    token_id as field;
    name as u128;
    symbol as u128;
    decimals as u8;
    supply as u128;
    max_supply as u128;
    admin as address;
    external_authorization_required as boolean;
    external_authorization_party as address;

struct TokenOwner:
    account as address;
    token_id as field;

struct PoolDetail:
    pool_owner as address;
    token1_name as field;
    token2_name as field;
    balance1 as u128;
    balance2 as u128;
    supply as u128;

mapping pool_detail:
    key as u128.public;
    value as PoolDetail.public;

mapping pool_id:
    key as boolean.public;
    value as u128.public;

mapping self_address:
    key as boolean.public;
    value as address.public;

function init_dex:
    input r0 as address.private;
    async init_dex r0 into r1;
    output r1 as private_dex_01.aleo/init_dex.future;

finalize init_dex:
    input r0 as address.public;
    contains pool_id[true] into r1;
    not r1 into r2;
    assert.eq r2 true;
    set 0u128 into pool_id[true];
    set r0 into self_address[true];

function create_pool:
    input r0 as field.private;
    input r1 as field.private;
    async create_pool r0 r1 self.caller into r2;
    output r2 as private_dex_01.aleo/create_pool.future;

finalize create_pool:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as address.public;
    cast r2 r0 r1 0u128 0u128 0u128 into r3 as PoolDetail;
    get pool_id[true] into r4;
    add r4 1u128 into r5;
    set r3 into pool_detail[r5];
    set r5 into pool_id[true];

function add_liquidity:
    input r0 as u128.private;
    input r1 as field.private;
    input r2 as u128.private;
    input r3 as field.private;
    input r4 as u128.private;
    input r5 as address.private;
    call multi_token_support_program.aleo/transfer_from_public r1 self.caller r5 r2 into r6;
    call multi_token_support_program.aleo/transfer_from_public r3 self.caller r5 r4 into r7;
    async add_liquidity r0 r1 r2 r3 r4 self.caller r5 r6 r7 into r8;
    output r8 as private_dex_01.aleo/add_liquidity.future;

finalize add_liquidity:
    input r0 as u128.public;
    input r1 as field.public;
    input r2 as u128.public;
    input r3 as field.public;
    input r4 as u128.public;
