    assert.eq r0 r5.admin;
    mul r4 1000000u128 into r6;
    pow 10u128 r5.native_decimals into r7;
    div r6 r7 into r8;
    get approvals[r2] into r9;
    sub r9 r8 into r10;
    set r10 into approvals[r2];
    sub r5.total_supply r8 into r11;
    cast r5.name r5.symbol r5.native_decimals r11 r5.admin into r12 as TokenInfo;
    set r12 into tokens[r1];
    get account[r3] into r13;
    sub r13 r8 into r14;
    set r14 into account[r3];

