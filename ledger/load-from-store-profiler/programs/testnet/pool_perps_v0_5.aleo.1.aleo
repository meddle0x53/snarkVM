    output r5 as pool_perps_v0_5.aleo/mint.future;

finalize mint:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as u128.public;
    get tokens[r1] into r4;
    assert.eq r0 r4.admin;
    mul r3 1000000u128 into r5;
    pow 10u128 r4.native_decimals into r6;
    div r5 r6 into r7;
    add r4.total_supply r7 into r8;
    cast r4.name r4.symbol r4.native_decimals r8 r4.admin into r9 as TokenInfo;
    set r9 into tokens[r1];
    get.or_use account[r2] 0u128 into r10;
    add r10 r7 into r11;
    set r11 into account[r2];

function burn_from:
