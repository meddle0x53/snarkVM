    cast pool_perps_v0_5.aleo r7 r5 into r8 as TokenId;
    hash.bhp256 r8 into r9 as field;
    async create_token self.caller r9 r0 r1 r2 r3 r4 into r10;
    output r10 as pool_perps_v0_5.aleo/create_token.future;

finalize create_token:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u8.public;
    input r5 as u128.public;
    input r6 as address.public;
    contains tokens[r1] into r7;
    assert.eq r7 false;
    cast r2 r3 r4 r5 r6 into r8 as TokenInfo;
    set r8 into tokens[r1];
    cast r1 r0 into r9 as AccountKey;
    hash.bhp256 r9 into r10 as field;
    set r5 into account[r10];

function mint:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as u128.public;
    cast r0 r1 into r3 as AccountKey;
    hash.bhp256 r3 into r4 as field;
