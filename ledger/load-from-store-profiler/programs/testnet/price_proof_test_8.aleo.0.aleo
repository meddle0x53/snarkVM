    output r1 as price_proof_test_8.aleo/receive_oracle_price.future;

finalize receive_oracle_price:
    input r0 as u64.public;
    get.or_use market_state[aleo1utnfugwpu6ac8z0dp90mlulvrgf768984huy7gwfcr0676hfmv9qwxkl9n] 0u8 into r1;
    assert.eq r1 2u8;
    set r0 into oracle_price[true];
    set 3u8 into market_state[aleo1utnfugwpu6ac8z0dp90mlulvrgf768984huy7gwfcr0676hfmv9qwxkl9n];

function claim_bet:
