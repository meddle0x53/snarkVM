program rep_engine_v4.aleo;

struct RankingInfo:
    player as address;
    points as u64;

struct Ranking:
    p_1 as RankingInfo;
    p_2 as RankingInfo;
    p_3 as RankingInfo;
    p_4 as RankingInfo;
    p_5 as RankingInfo;
    p_6 as RankingInfo;
    p_7 as RankingInfo;
    p_8 as RankingInfo;
    p_9 as RankingInfo;
    p_10 as RankingInfo;

record LeaderBoard:
    owner as address.private;
    ranking as Ranking.public;
    season as u64.public;

record Match:
    owner as address.private;
    opponent as address.private;
    winner_choice as u64.private;
    opponent_choice as u64.private;

record MatchAudit:
    owner as address.private;
    winner as address.private;
    opponent as address.private;
    winner_choice as u64.private;
    opponent_choice as u64.private;

struct MatchInfo:
    winner as address;
    opponent as address;
    winner_choice as u64;
    opponent_choice as u64;

mapping balances:
    key as address.public;
    value as u64.public;

function new_leaderboard:
    input r0 as address.private;
    input r1 as u64.private;
    cast r0 0u64 into r2 as RankingInfo;
    cast r0 0u64 into r3 as RankingInfo;
    cast r0 0u64 into r4 as RankingInfo;
    cast r0 0u64 into r5 as RankingInfo;
    cast r0 0u64 into r6 as RankingInfo;
    cast r0 0u64 into r7 as RankingInfo;
    cast r0 0u64 into r8 as RankingInfo;
    cast r0 0u64 into r9 as RankingInfo;
    cast r0 0u64 into r10 as RankingInfo;
    cast r0 0u64 into r11 as RankingInfo;
    cast r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 into r12 as Ranking;
    cast r0 r12 r1 into r13 as LeaderBoard.record;
    output r13 as LeaderBoard.record;

closure update_ranking:
