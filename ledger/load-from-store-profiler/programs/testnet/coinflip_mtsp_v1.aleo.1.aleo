import credits.aleo;
import multi_token_support_program.aleo;
import coinflip_admin_v1.aleo;

program coinflip_mtsp_v1.aleo;

struct TokenMetadata:
    token_id as field;
    name as u128;
    symbol as u128;
    decimals as u8;
    supply as u128;
    max_supply as u128;
    admin as address;
    external_authorization_required as boolean;
    external_authorization_party as address;

struct TokenOwner:
    account as address;
    token_id as field;

struct Balance:
    token_id as field;
    account as address;
    balance as u128;
    authorized_until as u32;

mapping admin:
    key as boolean.public;
    value as address.public;

mapping amount_limit:
    key as boolean.public;
    value as u64.public;

mapping user_balance:
    key as field.public;
    value as u64.public;

mapping user_streak:
    key as field.public;
    value as [boolean; 5u32].public;

function initialize:
    input r0 as address.private;
    input r1 as u64.private;
    gt r1 0u64 into r2;
    assert.eq r2 true;
    async initialize r0 r1 into r3;
    output r3 as coinflip_mtsp_v1.aleo/initialize.future;

finalize initialize:
    input r0 as address.public;
    input r1 as u64.public;
    contains admin[true] into r2;
    not r2 into r3;
    assert.eq r3 true;
    set r0 into admin[true];
    set r1 into amount_limit[true];

function bet_public_token:
