    cast r7 into r8 as u128;
    call multi_token_support_program.aleo/transfer_public_as_signer r2 coinflip_admin_v1.aleo r8 into r9;
    async bet_public_token self.caller r7 r0 r1 r2 r9 into r10;
    output r10 as coinflip_mtsp_v1.aleo/bet_public_token.future;

