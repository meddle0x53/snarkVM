program rediwsozfo.aleo;

struct MerkleProof:
    siblings as [field; 4u32];
    leaf_index as u32;

function build_tree:
    input r0 as [address; 8u32].private;
    cast r0[0u32] into r1 as field;
    cast r0[1u32] into r2 as field;
    cast r1 r2 into r3 as [field; 2u32];
    hash.psd4 r3 into r4 as field;
    cast r0[2u32] into r5 as field;
    cast r0[3u32] into r6 as field;
    cast r5 r6 into r7 as [field; 2u32];
    hash.psd4 r7 into r8 as field;
    cast r0[4u32] into r9 as field;
    cast r0[5u32] into r10 as field;
    cast r9 r10 into r11 as [field; 2u32];
    hash.psd4 r11 into r12 as field;
    cast r0[6u32] into r13 as field;
    cast r0[7u32] into r14 as field;
    cast r13 r14 into r15 as [field; 2u32];
    hash.psd4 r15 into r16 as field;
    cast r4 r8 into r17 as [field; 2u32];
    hash.psd4 r17 into r18 as field;
    cast r12 r16 into r19 as [field; 2u32];
    hash.psd4 r19 into r20 as field;
    cast r18 r20 into r21 as [field; 2u32];
    hash.psd4 r21 into r22 as field;
    cast r0[0u32] into r23 as field;
    cast r0[1u32] into r24 as field;
    cast r0[2u32] into r25 as field;
    cast r0[3u32] into r26 as field;
    cast r0[4u32] into r27 as field;
    cast r0[5u32] into r28 as field;
    cast r0[6u32] into r29 as field;
    cast r0[7u32] into r30 as field;
    cast r23 r24 r25 r26 r27 r28 r29 r30 r4 r8 r12 r16 r18 r20 r22 into r31 as [field; 15u32];
    output r31 as [field; 15u32].private;

function verify_non_inclusion:
    input r0 as address.private;
    input r1 as [MerkleProof; 2u32].private;
    rem r1[0u32].leaf_index 2u32 into r2;
    is.eq r2 0u32 into r3;
    cast r1[0u32].siblings[0u32] r1[0u32].siblings[1u32] into r4 as [field; 2u32];
    hash.psd4 r4 into r5 as field;
    not r3 into r6;
    cast r1[0u32].siblings[1u32] r1[0u32].siblings[0u32] into r7 as [field; 2u32];
    hash.psd4 r7 into r8 as field;
    ternary r3 r5 r8 into r9;
    div r1[0u32].leaf_index 2u32 into r10;
    rem r10 2u32 into r11;
    is.eq r11 0u32 into r12;
    cast r9 r1[0u32].siblings[2u32] into r13 as [field; 2u32];
    hash.psd4 r13 into r14 as field;
    not r12 into r15;
    cast r1[0u32].siblings[2u32] r9 into r16 as [field; 2u32];
    hash.psd4 r16 into r17 as field;
    ternary r12 r14 r17 into r18;
    is.neq r1[0u32].siblings[3u32] 0field into r19;
    div r1[0u32].leaf_index 4u32 into r20;
    rem r20 2u32 into r21;
    is.eq r21 0u32 into r22;
    cast r18 r1[0u32].siblings[3u32] into r23 as [field; 2u32];
    hash.psd4 r23 into r24 as field;
    not r22 into r25;
    cast r1[0u32].siblings[3u32] r18 into r26 as [field; 2u32];
    hash.psd4 r26 into r27 as field;
    ternary r22 r24 r27 into r28;
    ternary r19 r28 r18 into r29;
    rem r1[1u32].leaf_index 2u32 into r30;
    is.eq r30 0u32 into r31;
    cast r1[1u32].siblings[0u32] r1[1u32].siblings[1u32] into r32 as [field; 2u32];
    hash.psd4 r32 into r33 as field;
    not r31 into r34;
    cast r1[1u32].siblings[1u32] r1[1u32].siblings[0u32] into r35 as [field; 2u32];
    hash.psd4 r35 into r36 as field;
    ternary r31 r33 r36 into r37;
    div r1[1u32].leaf_index 2u32 into r38;
    rem r38 2u32 into r39;
    is.eq r39 0u32 into r40;
    cast r37 r1[1u32].siblings[2u32] into r41 as [field; 2u32];
    hash.psd4 r41 into r42 as field;
    not r40 into r43;
    cast r1[1u32].siblings[2u32] r37 into r44 as [field; 2u32];
    hash.psd4 r44 into r45 as field;
    ternary r40 r42 r45 into r46;
    is.neq r1[1u32].siblings[3u32] 0field into r47;
    div r1[1u32].leaf_index 4u32 into r48;
    rem r48 2u32 into r49;
    is.eq r49 0u32 into r50;
    cast r46 r1[1u32].siblings[3u32] into r51 as [field; 2u32];
    hash.psd4 r51 into r52 as field;
    not r50 into r53;
    cast r1[1u32].siblings[3u32] r46 into r54 as [field; 2u32];
    hash.psd4 r54 into r55 as field;
    ternary r50 r52 r55 into r56;
    ternary r47 r56 r46 into r57;
    assert.eq r29 r57;
    cast r0 into r58 as field;
    is.eq r1[0u32].leaf_index r1[1u32].leaf_index into r59;
    is.eq r1[0u32].leaf_index 0u32 into r60;
    and r59 r60 into r61;
    not r61 into r62;
    is.eq r1[0u32].siblings r1[1u32].siblings into r63;
    or r63 r62 into r64;
    assert.eq r64 true;
    lt r58 r1[0u32].siblings[0u32] into r65;
    not r61 into r66;
    or r65 r66 into r67;
    assert.eq r67 true;
    not r61 into r68;
    is.eq r1[0u32].leaf_index r1[1u32].leaf_index into r69;
    is.eq r1[0u32].leaf_index 7u32 into r70;
    and r69 r70 into r71;
    and r68 r71 into r72;
    not r72 into r73;
    is.eq r1[0u32].siblings r1[1u32].siblings into r74;
    or r74 r73 into r75;
    assert.eq r75 true;
    gt r58 r1[0u32].siblings[0u32] into r76;
    not r72 into r77;
    or r76 r77 into r78;
    assert.eq r78 true;
    not r71 into r79;
    gt r58 r1[0u32].siblings[0u32] into r80;
    and r68 r79 into r81;
    not r81 into r82;
    or r80 r82 into r83;
    assert.eq r83 true;
    lt r58 r1[1u32].siblings[0u32] into r84;
    not r81 into r85;
    or r84 r85 into r86;
    assert.eq r86 true;
    add r1[0u32].leaf_index 1u32 into r87;
    not r81 into r88;
    is.eq r87 r1[1u32].leaf_index into r89;
    or r89 r88 into r90;
    assert.eq r90 true;
    output r29 as field.private;
