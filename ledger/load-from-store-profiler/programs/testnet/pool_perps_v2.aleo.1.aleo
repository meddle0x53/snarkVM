    sub r10 r4 into r11;
    set r11 into account[r9];
    cast r0 r3 into r12 as AccountKey;
    hash.bhp256 r12 into r13 as field;
    get.or_use account[r13] 0u128 into r14;
    add r14 r4 into r15;
