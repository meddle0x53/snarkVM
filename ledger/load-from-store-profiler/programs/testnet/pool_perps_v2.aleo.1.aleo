function withdraw_fee:
    input r0 as field.public;
    input r1 as address.public;
    cast r0 r1 into r2 as AccountKey;
    hash.bhp256 r2 into r3 as field;
    cast r0 pool_perps_v2.aleo into r4 as AccountKey;
    hash.bhp256 r4 into r5 as field;
    async withdraw_fee self.caller r0 r3 r5 into r6;
    output r6 as pool_perps_v2.aleo/withdraw_fee.future;

finalize withdraw_fee:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    get config_perps_v2.aleo/super_admin[true] into r4;
    assert.eq r0 r4;
    get fee_reserves[r1] into r5;
    assert.neq r5 0u128;
    set 0u128 into fee_reserves[r1];
    get.or_use account[r2] 0u128 into r6;
    add r6 r5 into r7;
    set r7 into account[r2];
    get account[r3] into r8;
    sub r8 r5 into r9;
    set r9 into account[r3];

function set_usda_amount:
    input r0 as field.public;
    input r1 as u128.public;
    async set_usda_amount self.caller r0 r1 into r2;
    output r2 as pool_perps_v2.aleo/set_usda_amount.future;

finalize set_usda_amount:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as u128.public;
    get config_perps_v2.aleo/is_governor[r0] into r3;
    assert.eq r3 true;
    get.or_use usda_amounts[r1] 0u128 into r4;
    gt r2 r4 into r5;
    set r2 into usda_amounts[r1];
    get.or_use config_perps_v2.aleo/max_usda_amounts[r1] 0u128 into r6;
    is.neq r6 0u128 into r7;
    and r5 r7 into r8;
    branch.eq r8 false to end_then_0_0;
    lte r2 r6 into r9;
    assert.eq r9 true;
    branch.eq true true to end_otherwise_0_1;
    position end_then_0_0;
    position end_otherwise_0_1;

function update_tpsl_fee_reserves:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as u128.public;
    cast r1 r0 into r3 as AccountKey;
    hash.bhp256 r3 into r4 as field;
    cast r1 pool_perps_v2.aleo into r5 as AccountKey;
    hash.bhp256 r5 into r6 as field;
    async update_tpsl_fee_reserves self.caller r1 r4 r6 r2 into r7;
    output r7 as pool_perps_v2.aleo/update_tpsl_fee_reserves.future;

finalize update_tpsl_fee_reserves:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u128.public;
    assert.eq r0 position_router_perps_v2.aleo;
    get.or_use fee_reserves[r1] 0u128 into r5;
    add r5 r4 into r6;
    set r6 into fee_reserves[r1];
    get account[r2] into r7;
    sub r7 r4 into r8;
    set r8 into account[r2];
    get account[r3] into r9;
    add r9 r4 into r10;
    set r10 into account[r3];
