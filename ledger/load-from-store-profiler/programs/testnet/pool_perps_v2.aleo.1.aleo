    is.eq self.caller aleo1cnm2w8qlrhahlsmalph7t0jh3adny5pj4m38jgpcdzt2reqthurqaen3dp into r6;
    ternary r6 pool_perps_v2.aleo self.caller into r7;
    cast pool_perps_v2.aleo r7 r5 into r8 as TokenId;
    hash.bhp256 r8 into r9 as field;
    async create_token self.caller r9 r0 r1 r2 r3 r4 into r10;
    output r10 as pool_perps_v2.aleo/create_token.future;

finalize create_token:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u8.public;
    input r5 as u128.public;
    input r6 as address.public;
    contains tokens[r1] into r7;
    assert.eq r7 false;
    cast r2 r3 r4 r5 r6 into r8 as TokenInfo;
    set r8 into tokens[r1];
    cast r1 r0 into r9 as AccountKey;
    hash.bhp256 r9 into r10 as field;
    set r5 into account[r10];

function mint:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as u128.public;
    cast r0 r1 into r3 as AccountKey;
    hash.bhp256 r3 into r4 as field;
    async mint self.caller r0 r4 r2 into r5;
    output r5 as pool_perps_v2.aleo/mint.future;

finalize mint:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as u128.public;
    get tokens[r1] into r4;
    assert.eq r0 r4.admin;
    mul r3 1000000u128 into r5;
    pow 10u128 r4.native_decimals into r6;
    div r5 r6 into r7;
    add r4.total_supply r7 into r8;
    cast r4.name r4.symbol r4.native_decimals r8 r4.admin into r9 as TokenInfo;
    set r9 into tokens[r1];
    get.or_use account[r2] 0u128 into r10;
    add r10 r7 into r11;
    set r11 into account[r2];

function burn_from:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as u128.public;
    cast r0 r1 self.caller into r3 as ApprovalKey;
    hash.bhp256 r3 into r4 as field;
    cast r0 r1 into r5 as AccountKey;
    hash.bhp256 r5 into r6 as field;
    async burn_from self.caller r0 r4 r6 r2 into r7;
    output r7 as pool_perps_v2.aleo/burn_from.future;

finalize burn_from:
    input r0 as address.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as field.public;
    input r4 as u128.public;
    get tokens[r1] into r5;
    assert.eq r0 r5.admin;
    mul r4 1000000u128 into r6;
    pow 10u128 r5.native_decimals into r7;
    div r6 r7 into r8;
    get approvals[r2] into r9;
    sub r9 r8 into r10;
    set r10 into approvals[r2];
    sub r5.total_supply r8 into r11;
    cast r5.name r5.symbol r5.native_decimals r11 r5.admin into r12 as TokenInfo;
    set r12 into tokens[r1];
    get account[r3] into r13;
    sub r13 r8 into r14;
    set r14 into account[r3];

function transfer_public:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as u128.public;
    cast r0 self.caller into r3 as AccountKey;
    hash.bhp256 r3 into r4 as field;
    cast r0 r1 into r5 as AccountKey;
    hash.bhp256 r5 into r6 as field;
    async transfer_public r0 r4 r6 r2 into r7;
    output r7 as pool_perps_v2.aleo/transfer_public.future;

finalize transfer_public:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as field.public;
    input r3 as u128.public;
    contains tokens[r0] into r4;
    assert.eq r4 true;
    get account[r1] into r5;
    sub r5 r3 into r6;
    set r6 into account[r1];
    get.or_use account[r2] 0u128 into r7;
    add r7 r3 into r8;
    set r8 into account[r2];

function approve_public:
    input r0 as field.public;
    input r1 as address.public;
    input r2 as u128.public;
    cast r0 self.caller r1 into r3 as ApprovalKey;
