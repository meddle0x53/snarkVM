function burn:
    input r0 as field.public;
    input r1 as u128.public;
    cast r0 self.caller into r2 as AccountKey;
    hash.bhp256 r2 into r3 as field;
    async burn r3 r0 r1 into r4;
    output r4 as pool_perps_v2.aleo/burn.future;

finalize burn:
    input r0 as field.public;
    input r1 as field.public;
    input r2 as u128.public;
    get tokens[r1] into r3;
    sub r3.total_supply r2 into r4;
    cast r3.name r3.symbol r3.native_decimals r4 r3.admin into r5 as TokenInfo;
    set r5 into tokens[r1];
    get account[r0] into r6;
    sub r6 r2 into r7;
    set r7 into account[r0];

