function public_claim_token:
    input r0 as u64.private;
    input r1 as field.private;
    gt r0 0u64 into r2;
    assert.eq r2 true;
    cast r0 into r3 as u128;
    call coinflip_admin_v3.aleo/give_token self.caller r3 r1 into r4;
    async public_claim_token r4 self.caller r0 r1 into r5;
    output r5 as coinflip_mtsp_v3.aleo/public_claim_token.future;

finalize public_claim_token:
    input r0 as coinflip_admin_v3.aleo/give_token.future;
    input r1 as address.public;
    input r2 as u64.public;
    input r3 as field.public;
    await r0;
    cast r1 r3 into r4 as TokenOwner;
    hash.bhp256 r4 into r5 as field;
    get user_balance[r5] into r6;
    gte r6 r2 into r7;
    assert.eq r7 true;
    get.or_use user_balance[r5] 0u64 into r8;
    sub r8 r2 into r9;
    set r9 into user_balance[r5];

function private_claim_token:
    input r0 as u64.private;
    input r1 as field.private;
    gt r0 0u64 into r2;
    assert.eq r2 true;
    call coinflip_admin_v3.aleo/give_token_private self.caller r0 r1 into r3 r4;
    cast self.caller r1 into r5 as TokenOwner;
    hash.bhp256 r5 into r6 as field;
    async private_claim_token r4 r6 r0 into r7;
    output r3 as token_registry.aleo/Token.record;
    output r7 as coinflip_mtsp_v3.aleo/private_claim_token.future;

finalize private_claim_token:
    input r0 as coinflip_admin_v3.aleo/give_token_private.future;
    input r1 as field.public;
    input r2 as u64.public;
    await r0;
    get user_balance[r1] into r3;
    gte r3 r2 into r4;
    assert.eq r4 true;
    get.or_use user_balance[r1] 0u64 into r5;
    sub r5 r2 into r6;
    set r6 into user_balance[r1];

