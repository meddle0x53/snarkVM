program amm_state_v001.aleo;

struct ReserveData:
    token_id as field;
    last_update_block_height as u32;
    liquidity_rate as u128;
    borrow_rate as u128;
    liquidity_cumulative_index as u128;
    borrow_cumulative_index as u128;
    base_LTV_as_collateral as u128;
    liquidation_threshold as u128;
    liquidation_bonus as u128;
    decimals as u8;
    optimal_utilization_rate as u128;
    base_borrow_rate as u128;
    borrowing_enabled as boolean;
    usage_as_collateral_enabled as boolean;
    is_freezed as boolean;
    is_active as boolean;

struct UserData:
    last_updated_block_height as u32;
    origination_fee as u128;
    total_liquidity_balance_USD as u128;
    total_collateral_balance_USD as u128;
    total_borrow_balance_USD as u128;
    total_fees_USD as u128;
    avaialble_borrow_USD as u128;
    current_LTV as u128;
    current_liquidation_threshold as u128;
    borrowing_power as u128;
    health_factor_below_threshold as boolean;
    collateral_needed_in_USD as u128;

mapping reserves:
    key as field.public;
    value as ReserveData.public;

mapping user_cumulative_index:
    key as field.public;
    value as u128.public;

mapping total_borrowed_amount:
    key as field.public;
    value as u128.public;

mapping borrowed_amount:
    key as field.public;
    value as u128.public;

mapping total_deposited_amount:
    key as field.public;
    value as u128.public;

mapping deposited_amount:
    key as field.public;
    value as u128.public;

mapping total_available_liquidity:
    key as field.public;
    value as u128.public;

mapping last_timeStamp:
    key as boolean.public;
    value as u32.public;

mapping allowed_programs:
    key as address.public;
    value as boolean.public;

mapping admin:
    key as boolean.public;
    value as address.public;

mapping utilitization_rate:
    key as field.public;
    value as u128.public;

mapping slope_rate1:
    key as field.public;
    value as u128.public;

mapping slope_rate2:
    key as field.public;
    value as u128.public;

mapping instant_cbi:
    key as field.public;
    value as u128.public;

mapping usersdata:
    key as field.public;
    value as UserData.public;

mapping origination_fee_percent:
    key as boolean.public;
    value as u128.public;

function initialize:
    async initialize self.caller into r0;
    output r0 as amm_state_v001.aleo/initialize.future;

finalize initialize:
    input r0 as address.public;
    set r0 into admin[true];
    set block.height into last_timeStamp[true];

function add_reserve:
    input r0 as field.private;
    input r1 as u32.private;
    input r2 as u128.private;
    input r3 as u128.private;
    input r4 as u128.private;
    input r5 as u128.private;
    input r6 as u128.private;
    input r7 as u128.private;
    input r8 as u128.private;
    input r9 as u8.private;
    input r10 as u128.private;
    input r11 as u128.private;
    input r12 as boolean.private;
    input r13 as boolean.private;
    input r14 as boolean.private;
    input r15 as boolean.private;
    cast r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 into r16 as ReserveData;
    async add_reserve self.caller r16 into r17;
    output r17 as amm_state_v001.aleo/add_reserve.future;

finalize add_reserve:
    input r0 as address.public;
    input r1 as ReserveData.public;
    cast r1.token_id block.height r1.liquidity_rate r1.borrow_rate r1.liquidity_cumulative_index r1.borrow_cumulative_index r1.base_LTV_as_collateral r1.liquidation_threshold r1.liquidation_bonus r1.decimals r1.optimal_utilization_rate r1.base_borrow_rate r1.borrowing_enabled r1.usage_as_collateral_enabled r1.is_freezed r1.is_active into r2 as ReserveData;
    set r2 into reserves[r1.token_id];

function instant_cumulated_borrow_rate:
    input r0 as field.private;
    async instant_cumulated_borrow_rate self.caller r0 into r1;
    output r1 as amm_state_v001.aleo/instant_cumulated_borrow_rate.future;

