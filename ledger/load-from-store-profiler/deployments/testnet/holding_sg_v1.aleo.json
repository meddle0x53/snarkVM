 r2 into r5;\n    set r5 into holdings[r1];\n\nfunction release_fund:\n    input r0 as address.public;\n    input r1 as field.public;\n    input r2 as u128.public;\n    call multi_token_support_program.aleo/transfer_public r1 r0 r2 into r3;\n    cast r0 r1 into r4 as Holder;\n    async release_fund r3 self.caller r4 r2 into r5;\n    output r5 as holding_sg_v1.aleo/release_fund.future;\n\nfinalize release_fund:\n    input r0 as multi_token_support_program.aleo/transfer_public.future;\n    input r1 as address.public;\n    input r2 as Holder.public;\n    input r3 as u128.public;\n    await r0;\n    get owner_holding[true] into r4;\n    assert.eq r1 r4;\n    get holdings[r2] into r5;\n    sub r5 r3 into r6;\n    set r6 into holdings[r2];\n","verifying_keys":[["initialize_holding",["","certificate1qyqsqqqqqqqqqq86v239zsvx5s2phfsmw3pxd2tykzmre7cuxujjfnm8g40cj3y79s7v30l3rsum9qt0fl7q46ktqgqqq8v3ugr"]],["transfer_ownership_holding",["","certificate1qyqsqqqqqqqqqqqgl0we53vg25aedtxdfkcm7lyxr9hv83tazrsehgcpqym4agc85v754pfmx3pm973yp749q9lkn5qqqvmdvgz"]],["hold_fund",["","certificate1qyqsqqqqqqqqqqp2020r4yfrnd5a8fmj2ccpy8lpwwl7vee33wyz8f0ddlr5pzy5gk8rgqgx374cmmkkcuqcvpgfn5qsqfl7wwg"]],["release_fund",["","certificate1qyqsqqqqqqqqqqy45kvaexuz5cpcg9gtcmhjd3fg4a38haq7tq67lln2kkj6s2qvpn7nlrgtg60253rt4xeg3j5nmwqqqu2nfcj"]]]},"fee":{"transition":{"id":"au1y9pqkmekauevze83n5zq76qm6ryphv4853met9svwm7k8x47gupqdlm9da","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"5452743345305387319718892023103026973013039354987335907221300971182954905835field","value":"8522575u64"},{"type":"public","id":"7147331065673631290222943990980453885274197950826820320355760380234520398551field","value":"0u64"},{"type":"public","id":"6231406085954775561265429041776531529757545694783632693148856962597768430894field","value":"7113170947158225273203990489129549156956309324608296903587817528201213109823field"}],"outputs":[{"type":"future","id":"305508003447556743548681115540177718767