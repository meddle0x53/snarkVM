ck:\n    input r0 as Unblock.public;\n    input r1 as multisig_1723202296.aleo/verify.future;\n    await r1;\n    remove aml_blocklist[r0.account];\n    get.or_use aml_version[true] 0u32 into r2;\n    add r2 1u32 into r3;\n    set r3 into aml_version[true];\n\nfunction issue_aml:\n    input r0 as address.private;\n    input r1 as u32.private;\n    cast self.signer r0 r1 into r2 as AML.record;\n    async issue_aml r0 r1 into r3;\n    output r2 as AML.record;\n    output r3 as aml_1723202296.aleo/issue_aml.future;\n\nfinalize issue_aml:\n    input r0 as address.public;\n    input r1 as u32.public;\n    contains aml_blocklist[r0] into r2;\n    not r2 into r3;\n    assert.eq r3 true;\n    get.or_use aml_version[true] 0u32 into r4;\n    assert.eq r1 r4;\n\nfunction verify_aml:\n    input r0 as AML.record;\n    cast r0.owner r0.account r0.version into r1 as AML.record;\n    async verify_aml r0.version into r2;\n    output r1 as AML.record;\n    output r2 as aml_1723202296.aleo/verify_aml.future;\n\nfinalize verify_aml:\n    input r0 as u32.public;\n    get.or_use aml_version[true] 0u32 into r1;\n    assert.eq r0 r1;\n","verifying_keys":[["block_",["","certificate1qyqsqqqqqqqqqqrzc848velrd9zalclg95506cu8aeduxhla0lgkaaqz4scs80clvsq5d5w0nlg07qd74sa3srk5fyqqqf96mnf"]],["unblock",["","certificate1qyqsqqqqqqqqqq93fyxrpu3fl5kusengl7gywchqzfnfa3cx5yf7rxxtqqmc3mfemfls6syvrcng5h2eddmrh0y635qqqgwenfk"]],["issue_aml",["","certificate1qyqsqqqqqqqqqqx8ufa4qz554m5euqelyjrdv780hu0j32mpzdyec6q2zywhlxxhdrvy0n8xqrlvx33x4x4lqth4vsqqqf9xsf9"]],["verify_aml",["","certificate1qyqsqqqqqqqqqqpnt0varxqq6tu0axfu56zag37jn5l7xdn9lnfz8me7850yelv9vlc8lp3288k0zaejw55w7jzkxxqsq0wahk9"]]]},"fee":{"transition":{"id":"au14kh4mldqg2w6yhhj9047x35jn3gs9rzre0sdl57du2zc6eulhsysr3amzs","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"6358898946782653320695798489323590608095425842015632585207032450785144497034field","value":"14093400u64"},{"type":"public","id":"23989534844811088364