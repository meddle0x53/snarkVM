nt.future;\n    await r0;\n\nfunction transfer_via_timeout:\n    input r0 as JointStake.record;\n    input r1 as JointTimeoutClaim.record;\n    assert.eq r0.owner r1.owner;\n    assert.eq r0.amount r1.amount;\n    mul r1.amount 5u64 into r2;\n    call puzzle_arcade_ticket_v001.aleo/mint r1.opponent r2 into r3 r4;\n    async transfer_via_timeout r4 into r5;\n    output r3 as puzzle_arcade_ticket_v001.aleo/PuzzleArcadeTicket.record;\n    output r5 as puzzle_multiparty_coin_v001.aleo/transfer_via_timeout.future;\n\nfinalize transfer_via_timeout:\n    input r0 as puzzle_arcade_ticket_v001.aleo/mint.future;\n    await r0;\n","verifying_keys":[["stake_transfer_in",["","certificate1qyqsqqqqqqqqqqp7t5c0zsme5zphyffl2dshknyvnj74qvl5u7rx30ns9kfq6x3mc68pqdv4tcmfaftllajhxkjgt2qsqwpkk6c"]],["stake_transfer_out",["","certificate1qyqsqqqqqqqqqqprnsnnn28x82qse3eq5hk0x5wjy6xmh30dzka8vjn9fuuhhh58k9fwwpr83jgvdjwwkl6rykajwuqqqrxnp6v"]],["join_stakes",["","certificate1qyqsqqqqqqqqqq8vzlhvfn3n7tl6kga750wecm7kpz3aaxdd928425ejmexuyjafnr292c6d2uczn7s86xkme6xywwqsqlr5vnp"]],["set_winner",["","certificate1qyqsqqqqqqqqqq8kjgj5cu3kyl4l2euc2rh4dkpzgsydugshx8xam646zpgcu77klcst7dax9ygelxpmyr0hz2gl22qqq6367wx"]],["transfer_stake_to_winner",["","certificate1qyqsqqqqqqqqqqq0lkda693hqjcdhnuf42c99q6hnhmzrmxzdq7k9ml0ctfksgsp3zsukyuwxgq756jy4s9s00yyg7qqq50jw5g"]],["transfer_via_timeout",["","certificate1qyqsqqqqqqqqqqp3e9vmva0teu05ce0ll20f4qtakaqr3r2qx6kmrq8scrl0nrfl8azcrdjzkp749p7akpnv7890psqsqzajal0"]]]},"fee":{"transition":{"id":"au18lm7zm4sm2266ph3ye8269hlqkaepzpe4cr2zu3uvplzrlgm5cgsjxd00w","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"5922114383052757018269615394293815463882761013063616324333681391767821034441field","value":"37569725u64"},{"type":"public","id":"5834091490328925942542644859028563252850357958292640181123930671284118751621field","value":"0u64"},{"type":"public","id":"4163023609651228755723468036070600116683834327850847019269400686397269481113field","v