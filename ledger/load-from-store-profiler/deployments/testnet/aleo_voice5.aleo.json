aller;\n    hash.keccak512 r0 into r2 as field;\n    hash.keccak512 r1 into r3 as field;\n    add r2 r3 into r4;\n    cast r0 r2 r1 r4 into r5 as CoBind.record;\n    output r5 as CoBind.record;\n","verifying_keys":[["send_voice",["","certificate1qyqsqqqqqqqqqq97aqm9nx3l6urdwxuv2q33p7pnvey5jdp5y2f6u5cp8lzue6hsuev8qtz3jy4vwrpl85gd86722wqsq7cpaap"]],["combine_owner_receiver_hash",["","certificate1qyqsqqqqqqqqqqz76vhalk4wwz9nhjfeggy5yqg6k32s4qq7gqqy42lmd04un54lz58pqqnm86fttrd9mcehqtc6fzqsq8mk5l8"]]]},"fee":{"transition":{"id":"au1ksecdztggxx32a3cn6j8q8p3zdznyfh9tlj6jyj6tk6qyz8rzqxsqfmywx","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"1079124671882464000528292665494098291627498577941028518740732614698418526548field","value":"38109050u64"},{"type":"public","id":"6590291466721734627038002640488086225626138996156878583637347896086678198186field","value":"0u64"},{"type":"public","id":"1894177225508848652132386215747053473867551661267230662961480944431388988107field","value":"1581070156001461204638519387021845476100413698964142699691974775670090929265field"}],"outputs":[{"type":"future","id":"1538401487312538763174950349078806987095540562127032248159828932558208295011field","value":"{\n  program_id: credits.aleo,\n  function_name: fee_public,\n  arguments: [\n    aleo1rhgdu77hgyqd3xjj8ucu3jj9r2krwz6mnzyd80gncr5fxcwlh5rsvzp9px,\n    38109050u64\n  ]\n}"}],"tpk":"6079764698213215927321790985994117693997413983669462723215317211954914227283group","tcm":"6614573457265393878190010945132076266407106327073014355317855527606067185186field","scm":"3045200039537178142734642529187011400576572207139209776712424401359588194426field"},"global_state_root":"sr146trl6tfvztugn367m5vzyzage9c6gnqdcdl3tnh2qpz8fz4hggscgtuac","proof":""}}