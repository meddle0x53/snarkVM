.future;\n    await r1;\n    assert.eq true true;\n    get credits.aleo/account[coinflip_v002.aleo] into r2;\n    get status[true] into r3;\n    assert.eq r3 1u8;\n    get amount_limit[true] into r4;\n    lte r0 r4 into r5;\n    assert.eq r5 true;\n    mul r0 2u64 into r6;\n    gte r2 r6 into r7;\n    assert.eq r7 true;\n\nfunction reveal:\n    input r0 as Toss.record;\n    mul r0.amount 2u64 into r1;\n    hash.bhp256 r0.owner into r2 as field;\n    async reveal r0.coin r2 r0.amount into r3;\n    output r3 as coinflip_v002.aleo/reveal.future;\n\nfinalize reveal:\n    input r0 as boolean.public;\n    input r1 as field.public;\n    input r2 as u64.public;\n    rand.chacha into r3 as boolean;\n    is.eq r3 r0 into r4;\n    branch.eq r4 false to end_then_0_0;\n    get.or_use user_amount[r1] 0u64 into r5;\n    mul r2 2u64 into r6;\n    add r5 r6 into r7;\n    set r7 into user_amount[r1];\n    branch.eq true true to end_otherwise_0_1;\n    position end_then_0_0;\n    set 0u64 into user_amount[r1];\n    position end_otherwise_0_1;\n\nfunction claim:\n    input r0 as u64.private;\n    call credits.aleo/transfer_public_to_private self.caller r0 into r1 r2;\n    hash.bhp256 self.caller into r3 as field;\n    async claim r2 r3 r0 into r4;\n    output r1 as credits.aleo/credits.record;\n    output r4 as coinflip_v002.aleo/claim.future;\n\nfinalize claim:\n    input r0 as credits.aleo/transfer_public_to_private.future;\n    input r1 as field.public;\n    input r2 as u64.public;\n    await r0;\n    get user_amount[r1] into r3;\n    gte r3 r2 into r4;\n    assert.eq r4 true;\n    get.or_use user_amount[r1] 0u64 into r5;\n    sub r5 r2 into r6;\n    set r6 into user_amount[r1];\n\nfunction unpause:\n    async unpause self.caller into r0;\n    output r0 as coinflip_v002.aleo/unpause.future;\n\nfinalize unpause:\n    input r0 as address.public;\n    get admin[true] into r1;\n    assert.eq r0 r1;\n    set 1u8 into status[true];\n\nfunction pause:\n    async pause self.caller into r0;\n    output r0 as coinflip_v002.aleo/pause.future;\n\nfinalize pause:\n    input r0 as address.public;\n    get admin[true] into r1;\n    assert.eq r0 r1;\n    set 0u8 into status[true];\n","verifying_keys":[["initialize",["","certificate1qyqsqqqqqqqqqq8fjf0tha2uee82xv7hgxjne0gf62wcqgryvhxcr36y5uesl0mkc66pzkyrxwfa483jx93q0qlrsgqqq54wjyq"]],["bet",["","certificate1qyqsqqqqqqqqqqyh65f5l7r7elxw5dfe2vyx2e5z6dm5ly2mresc67y77zanmwedty76utv8k7t7xr3hlh0jxnprn2qqq4rlwr6"]],["reveal",["","certificate1qyqsqqqqqqqqqqxyc6f8lv85ym255grz960fr66j6nwyvj3gm3q58k0gwl3gs3dpvhk5xyc59y3wt69r4mkzy6atsxqsqekxkes"]],["claim",["","certificate1qyqsqqqqqqqqqqxydgz8s7yupspurlw7z2ss3vptvr7eampkmc6ry30jux70t8zne0nyuhpnusdut8npc9lgwgh3jgqsqdnjr8z"]],["unpause",["","certificate1qyqsqqqqqqqqqqzhzxenalsyzqgs4k82yhtu2u4mr2um5dkje0u4zw8t9yk5zaa9z907gwnpu07n6m0v93qr9cte6wqqq4trj3z"]],["pause",["","certificate1qyqsqqqqqqqqqq88mdcupwqk6zd5gyc2zjalf6ncexwz8hld7vqn40uwckwhxysk2tunzkzwy0lz66j0rk7he5dsl2qqq66juve"]]]},"fee":{"transition":{"id":"au1sxrjqshrnu744efhxhu5ftm8fdnu574rmflvhemwc5hzmqecv58s728rhg","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"2725810156820742745430013318860952225430208529040146525369690541628170395395field","value":"15687250u64"},{"type":"public","id":"6174047671934157079091736268236213326406488921549817880892963325481262441333field","value":"0u64"},{"type":"public","id":"5232716230786559846381162684967108410425056198600611119043643415078156925962field","value":"2163219996124505629103215303042877502581409519602027579265055103613817637911field"}],"outputs":[{"type":"future","id":"3226118393516625045379251672485276784244610121211183182459432459504471221094field","value":"{\n  program_id: credits.aleo,\n  function_name: fee_public,\n  arguments: [\n    aleo1rhgdu77hgyqd3xjj8ucu3jj9r2krwz6mnzyd80gncr5fxcwlh5rsvzp9px,\n    15687250u64\n  ]\n}"}],"tpk":"7733226323139219178687667243278362801608741959326071040252798790536793141792group","tcm":"481462904719