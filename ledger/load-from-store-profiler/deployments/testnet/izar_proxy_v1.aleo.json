aleo/proxy_regist_token.future;\n\nfinalize proxy_regist_token:\n    input r0 as izar_token_v1.aleo/regist_token.future;\n    await r0;\n\nfunction pending:\n    input r0 as IzarCrossMsg.private;\n    gte r0.amount 3000000000000000000u128 into r1;\n    assert.eq r1 true;\n    hash.bhp256 r0 into r2 as field;\n    async pending r2 into r3;\n    output r3 as izar_proxy_v1.aleo/pending.future;\n\nfinalize pending:\n    input r0 as field.public;\n    add block.height 8640u32 into r1;\n    set r1 into pending_tx[r0];\n\nfunction add_blacklist:\n    input r0 as address.private;\n    assert.eq self.caller aleo1fmf9tha3nduaz57yq5lt43d55h0d3kfzyhh0jlkpqumyds3ssvgqj9mtut;\n    async add_blacklist r0 into r1;\n    output r1 as izar_proxy_v1.aleo/add_blacklist.future;\n\nfinalize add_blacklist:\n    input r0 as address.public;\n    set false into blacklist[r0];\n","verifying_keys":[["receive_payload",["","certificate1qyqsqqqqqqqqqq8q7lwlrzj3kwwdusyw9fsg5kh5pqka3yq6c8yx5lp6am8f5ayatu5prgr4wvw2g92ze5637went2qsqxattm4"]],["cross_public",["","certificate1qyqsqqqqqqqqqqpa8yzlzd0fh9a59kln6hj0arwv6utvds9uqk2d2eacle95n5gn27ljed0ym6dxcm37yszmkutjtuqsqt68gvx"]],["upgrade",["","certificate1qyqsqqqqqqqqqqql7ekvfj5pjukwurrtl7nv20qnn4qg7mts75vyvenwlxman9yq9t3mjkc82pyl6xey55new5ewcxqqq5ha5zu"]],["proxy_regist_token",["","certificate1qyqsqqqqqqqqqqzn70zcegzpchhmx5qnlgp9wglz6g0sk0ln4g0mx55f5aj32qxcuc089a3l9m69lryry27ylypag7qsqxxnhly"]],["pending",["","certificate1qyqsqqqqqqqqqq88uej5rsqzmpp5m0vt8g7tjv9ztgtqkj2hkzn28mrya0x84f0eg3p6v2ml0g0zxvn3pagq73xxpkqsquhhx5w"]],["add_blacklist",["","certificate1qyqsqqqqqqqqqq8xuyqdq5kz50fcd56lyzth0vtnl6w29656r5v30jdza3dvr03mulj4ptm55hf6txrmwp348lqvwgqsqnt4edc"]]]},"fee":{"transition":{"id":"au1yuxc03j2cw7mgzqc6apw4d9cruq48ts0trk4khzqpxqdtrl9dgzqqqx878","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"6670204112193448066690599212276848264715173117364420465301797276900634263886field","value":"20839725u64"},{"type":"public","id"