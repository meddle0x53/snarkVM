d r4 r2 into r5;\n    set r5 into holdings[r1];\n\nfunction release_fund:\n    input r0 as address.public;\n    input r1 as field.public;\n    input r2 as u128.public;\n    call multi_token_support_program.aleo/transfer_public r1 r0 r2 into r3;\n    cast r0 r1 into r4 as Holder;\n    async release_fund r3 self.caller r4 r2 into r5;\n    output r5 as holding_dev_v1.aleo/release_fund.future;\n\nfinalize release_fund:\n    input r0 as multi_token_support_program.aleo/transfer_public.future;\n    input r1 as address.public;\n    input r2 as Holder.public;\n    input r3 as u128.public;\n    await r0;\n    get owner_holding[true] into r4;\n    assert.eq r1 r4;\n    get holdings[r2] into r5;\n    sub r5 r3 into r6;\n    set r6 into holdings[r2];\n","verifying_keys":[["initialize_holding",["","certificate1qyqsqqqqqqqqqqy54m8mnq6547wrfnj3cm300n0qdak5kd7j5e0pq6skxa4z9gkqpq3dvad6rq9rltpk0k6xsztlpwqsqvgnxr5"]],["transfer_ownership_holding",["","certificate1qyqsqqqqqqqqqqp7ulhdahqy0l9x0ep6qakuvvmwz3uranmsqj9vvg4s7e0wwh85y67nksessr4586nwjka4yyq9kuqqqr977jm"]],["hold_fund",["","certificate1qyqsqqqqqqqqqq9mad65vd78e908qjqxyp27lnpwejw04h6xxleadw0p0a6vty3me26lnresft45mknc7dzcmwg0uyqqq9yzrr8"]],["release_fund",["","certificate1qyqsqqqqqqqqqqyxpshmg7g9cn6a5yr5eda9axnjmexgnwv8ru3ljygzg5k9mpztc33s0x0kz4ze9ea2y7u4vd9esyqsq2pwcjx"]]]},"fee":{"transition":{"id":"au1ququrtw4atqq5duue820lwvza2ejnpg04mrp4p898ccqe0t7xggq5da6me","program":"credits.aleo","function":"fee_public","inputs":[{"type":"public","id":"3359813418027277933513981820630585221645642546372895002201524759061915745734field","value":"8532775u64"},{"type":"public","id":"3260440604787985800405906263083846931791911162555058260389165506048402847292field","value":"0u64"},{"type":"public","id":"5243028783612787184844568045142836085711473250735124661419309520818890119008field","value":"3782427662948615685304413154380764197271234695247466505540627687303996597323field"}],"outputs":[{"type":"future","id":"1059245529479059006757523144895269